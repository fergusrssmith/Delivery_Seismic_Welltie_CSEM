#!/usr/bin/env bash
#
# This script requires JDK >= 1.5, 
# and runs the seismic inversion (delivery ) code
#
# All CAPITALISED variables imported from this file
source environment_setup.sh


CLASSPATH=$SEISMIC_INVERTER_HOME/jars/colt.jar:$SEISMIC_INVERTER_HOME/jars/concurrent.jar:$SEISMIC_INVERTER_HOME/au/csiro/JamesGunning/lib:$SEISMIC_INVERTER_HOME/:$SEISMIC_INVERTER_HOME/jars/FreeHEP.jar

# Memory management request (dugeo) can supply also e.g. --memMax 512
MEM_ARGS=""
params=""
for((i=1; i<=$#; i++)); do
        if [ "${!i}" == "--memMax" ]; then
                i=$((i+1))
				MEM_ARGS=-Xmx"${!i}"m
        else
                params="${params} ${!i}"
        fi
done
set -- ${params# }

# Use default java on user's path
# uncomment below to debug...
# echo $CLASSPATH

java $MEM_ARGS -classpath $CLASSPATH au.csiro.JamesGunning.seismicinverter.SeismicInverter $*

# CYGWIN users: change the above to
# java --Xmx${memMax}m classpath "$(cygpath -wp $CLASSPATH)" au.csiro.JamesGunning.seismicinverter.SeismicInverter $*
