#!/usr/bin/env bash

# Plots 2D section of a CMP inversion as a picture
# requires file with list of CMP x y locations etc as per
# docs for  au.csiro.JamesGunning.CSEM.plotting.PlotOccamSection 
#
# All CAPITALISED variables imported from this file
source environment_setup.sh

if [ ! -d $SEISMIC_INVERTER_HOME/au/csiro/JamesGunning/CSEM/plotting ]; then
	echo "Distribution does not yet contain CSEM code"
	exit
fi

# if cygpath exists, must be on cygwin/doze
if type -P cygpath &>/dev/null; then
  CLASSPATH=`cygpath -wp $SEISMIC_INVERTER_HOME/jars/colt.jar:$SEISMIC_INVERTER_HOME/jars/FreeHEP.jar:$SEISMIC_INVERTER_HOME/`
else
  CLASSPATH=$SEISMIC_INVERTER_HOME/jars/colt.jar:$SEISMIC_INVERTER_HOME:$SEISMIC_INVERTER_HOME/jars/FreeHEP.jar
fi

echo java -classpath $CLASSPATH $MODEL au.csiro.JamesGunning.CSEM.plotting.Plot1DCSEMSection $*
java -classpath $CLASSPATH $MODEL au.csiro.JamesGunning.CSEM.plotting.Plot1DCSEMSection $*
