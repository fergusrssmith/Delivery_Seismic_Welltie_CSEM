#!/usr/bin/env bash
#
# This script requires JDK >= 1.5, 
# and runs the seismic inversion sparse-spike code
#
# All CAPITALISED variables imported from this file
source environment_setup.sh


CLASSPATH=$SEISMIC_INVERTER_HOME/jars/colt.jar:$SEISMIC_INVERTER_HOME/jars/concurrent.jar:$SEISMIC_INVERTER_HOME/au/csiro/JamesGunning/lib:$SEISMIC_INVERTER_HOME:$SEISMIC_INVERTER_HOME/jars/FreeHEP.jar


# Use default java on user's path
# uncomment below to debug...
# echo $CLASSPATH

java -classpath $CLASSPATH au.csiro.JamesGunning.seismicinverter.SparseSpikeInverter $*

# CYGWIN users: change the above to
# java -classpath "$(cygpath -wp $CLASSPATH)" au.csiro.JamesGunning.seismicinverter.SparseSpikeInverter $*
