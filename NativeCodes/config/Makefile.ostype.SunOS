
CC			= cc
SYS_CFLAGS		= -Xa
SYS_CFLAGS_DEBUG	= -g -p -DDEBUG
SYS_CFLAGS_OPTIMISE	= -fast

CPP			= CC
SYS_CPPFLAGS		= -D'bool=unsigned char' -D'true=(bool)1' -D'false=(bool)0' \
				-instances=static
SYS_CPPFLAGS_DEBUG	= -g -p -DDEBUG
SYS_CPPFLAGS_OPTIMISE	= -fast

FC			= f77
SYS_FFLAGS		=
SYS_FFLAGS_DEBUG	= -g -p
SYS_FFLAGS_OPTIMISE	=

LD			= ld
SYS_LDFLAGS		=
SYS_LDFLAGS_DEBUG	= -g -p
SYS_LDFLAGS_OPTIMISE	=

AR			= ar
SYS_ARFLAGS		=

RM			= rm -f
CP			= cp -fp
