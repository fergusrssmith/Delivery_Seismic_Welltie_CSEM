<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <xsd:complexType name="vintageStressAndTimeType">
	<xsd:sequence>	
	<xsd:element name="delta_pore_pressure" minOccurs="1" type="varFloat" default="0"/>
	<xsd:element name="sigma_delta_pore_pressure" minOccurs="1" type="varFloat" default="0"/>
	<xsd:element name="sigma_time_shift" minOccurs="1" type="varFloat" default="0"/>
	</xsd:sequence>
  </xsd:complexType>	
  
  <xsd:complexType name="vintageStressAndTimeList">
	<xsd:sequence>	
	  <xsd:element name="vintage1_2" type="vintageStressAndTimeType" minOccurs="1"/>
	  <xsd:element name="vintage1_3" type="vintageStressAndTimeType" minOccurs="0"/>
	  <xsd:element name="vintage1_4" type="vintageStressAndTimeType" minOccurs="0"/>
	  <xsd:element name="vintage1_5" type="vintageStressAndTimeType" minOccurs="0"/>
	  <xsd:element name="vintage1_6" type="vintageStressAndTimeType" minOccurs="0"/>
	  <xsd:element name="vintage1_7" type="vintageStressAndTimeType" minOccurs="0"/>
	  <xsd:element name="vintage1_8" type="vintageStressAndTimeType" minOccurs="0"/>
	  <xsd:element name="vintage1_9" type="vintageStressAndTimeType" minOccurs="0"/>
	  <xsd:element name="vintage1_10" type="vintageStressAndTimeType" minOccurs="0"/>
	</xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="stressPathCoeffType">
	<xsd:sequence>	
	  <xsd:element name="vintage1_2" type="xsd:float" default="0" minOccurs="1"/>
	  <xsd:element name="vintage1_3" type="xsd:float" default="0" minOccurs="0"/>
	  <xsd:element name="vintage1_4" type="xsd:float" default="0" minOccurs="0"/>
	  <xsd:element name="vintage1_5" type="xsd:float" default="0" minOccurs="0"/>
	  <xsd:element name="vintage1_6" type="xsd:float" default="0" minOccurs="0"/>
	  <xsd:element name="vintage1_7" type="xsd:float" default="0" minOccurs="0"/>
	  <xsd:element name="vintage1_8" type="xsd:float" default="0" minOccurs="0"/>
	  <xsd:element name="vintage1_9" type="xsd:float" default="0" minOccurs="0"/>
	  <xsd:element name="vintage1_10" type="xsd:float" default="0" minOccurs="0"/>
	</xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="vsInt">
    <xsd:simpleContent>
      <xsd:extension base="xsd:integer">
        <xsd:attribute name="varies_areally" type="xsd:boolean" default="false"/>
		<xsd:attribute name="same_as_layer_above" type="xsd:boolean" default="false"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="varInt">
    <xsd:simpleContent>
      <xsd:extension base="xsd:integer">
        <xsd:attribute name="varies_areally" type="xsd:boolean" default="false"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="varFloat">
    <xsd:simpleContent>
      <xsd:extension base="xsd:float">
        <xsd:attribute name="varies_areally" type="xsd:boolean" default="false"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType> 
  
   <xsd:complexType name="varVinFloat">
    <xsd:simpleContent>
      <xsd:extension base="xsd:float">
        <xsd:attribute name="varies_areally" type="xsd:boolean" default="false"/>
        <xsd:attribute name="vintage" type="xsd:positiveInteger" default="1"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType> 

  <xsd:complexType name="varVinOrderFloat">
    <xsd:simpleContent>
      <xsd:extension base="xsd:float">
        <xsd:attribute name="varies_areally" type="xsd:boolean" default="false"/>
        <xsd:attribute name="vintage" type="xsd:positiveInteger" default="1"/>
        <xsd:attribute name="ordering" type="SorderingString" default="none"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType> 

  <xsd:complexType name="vsFloat">
    <xsd:simpleContent>
	  <xsd:extension base="xsd:float">
		<xsd:attribute name="varies_areally" type="xsd:boolean" default="false"/>
		<xsd:attribute name="same_as_layer_above" type="xsd:boolean" default="false"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="slinkInt">
    <xsd:simpleContent>
      <xsd:extension base="xsd:integer">
        <xsd:attribute name="stack_number" type="xsd:positiveInteger" default="1"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="clinkInt">
    <xsd:simpleContent>
      <xsd:extension base="xsd:integer">
        <xsd:attribute name="vintage" type="xsd:positiveInteger" default="1"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="clinkIntFC">
    <xsd:simpleContent>
      <xsd:extension base="xsd:integer">
        <xsd:attribute name="vintage" type="xsd:positiveInteger" default="1" use="required"/>
        <xsd:attribute name="type" type="contactString" default="OB" use="required"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="TLformat">
    <xsd:simpleContent>
      <xsd:extension base="xsd:boolean">
		<xsd:attribute name="time_lapse" type="xsd:boolean" default="true"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="appString">
	<xsd:simpleContent>
	  <xsd:extension base="xsd:string">
		<xsd:attribute name="applicable_layers" type="xsd:string" default="1"/>
	  </xsd:extension>
	</xsd:simpleContent>
  </xsd:complexType>

  <xsd:simpleType name="contactString"> 
	<xsd:restriction base="xsd:string"> 
	  <xsd:enumeration value="GB"/> 
	  <xsd:enumeration value="OB"/> 
	  <xsd:enumeration value="GO"/> 
	  <xsd:enumeration value="LB"/> 
	  <xsd:enumeration value="LO"/> 
	  <xsd:enumeration value="GL"/> 
	</xsd:restriction> 
  </xsd:simpleType> 

  <xsd:simpleType name="SorderingString"> 
	<xsd:restriction base="xsd:string"> 
	  <xsd:enumeration value="none"/> 
	  <xsd:enumeration value="less_than"/> 
	  <xsd:enumeration value="equals"/> 
	  <xsd:enumeration value="greater_than"/> 
	</xsd:restriction> 
  </xsd:simpleType> 

  <xsd:element name="inversion">
	<xsd:complexType>
	  <xsd:sequence>
		<xsd:element name="inversion_info">
		  <xsd:complexType>
			<xsd:sequence>
			  <xsd:element name="name" type="xsd:string" default="inversion title"/>
			  <xsd:element name="project" type="xsd:string" default="project name"/>
			  <xsd:element name="author" type="xsd:string" default="my name"/>
			</xsd:sequence>
		  </xsd:complexType>
		</xsd:element>

		<xsd:element name="time_lapse_format" type="xsd:boolean" minOccurs="1" maxOccurs="1" default="true"/>	

		<xsd:element name="seismic_data">
		  <xsd:complexType>
			<xsd:sequence>
			  <xsd:element name="stack" maxOccurs="unbounded">
				<xsd:complexType>
				  <xsd:sequence>
					<xsd:element name="name" type="xsd:string" default="full"/>
					<xsd:element name="vintage" type="xsd:positiveInteger" default="1"/>
					<xsd:element name="diff_stack" minOccurs="0">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="base_stack_name" type="xsd:anyURI" default="base"/>
						  <xsd:element name="final_stack_name" type="xsd:anyURI" default="monitor"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<xsd:element name="filename" type="xsd:anyURI" default="full_stack.su"/>
					<xsd:element name="min_offset" type="varFloat" default="0"/>
					<xsd:element name="max_offset" type="varFloat" default="4000"/>
					<xsd:element name="reflector_time" type="varFloat" default="1300"/>
					<xsd:element name="stack_velocity" type="varFloat" default="7400"/>
					<xsd:element name="wavelet">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="filename" type="xsd:anyURI" default="full_wavelet.su"/>
						  <!-- these are both the same. Rms is to be preferred -->
						  <xsd:element name="noise_rms" type="varFloat" minOccurs="1" default="1.0"/> 
						  <!-- Legacy -->
						  <!-- <xsd:element name="signal_to_noise" type="varFloat" minOccurs="1" default="0.1"/> -->
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<xsd:element name="time_above" type="varFloat" minOccurs="0" default="50"/>
					<xsd:element name="time_below" type="varFloat" minOccurs="0" default="50"/>
				  </xsd:sequence>
				  <xsd:attribute name="is-constant-angle-stack-with-angle-degrees" use="optional" type="xsd:float" default="-999.0"/>
			      <xsd:attribute name="is-PS-data" use="optional" type="xsd:boolean" default="false"/>
				</xsd:complexType>	
			  </xsd:element>
			  <xsd:element name="AVO_terms">
				<xsd:complexType>
				  <xsd:sequence>
					<xsd:element name="A" type="varFloat" default="1.0"/>
					<xsd:element name="sigma_A" minOccurs="0" type="varFloat" default="0"/>
					<xsd:element name="B" type="varFloat" default="1.0"/>
					<xsd:element name="sigma_B" minOccurs="0" type="varFloat" default="0"/>
				  </xsd:sequence>
				  <xsd:attribute name="synchronise_B_from_A" use="optional"  type="xsd:boolean" default="false"/>
				</xsd:complexType>	
			  </xsd:element>
			</xsd:sequence>
		  </xsd:complexType>
		</xsd:element>
		<xsd:element name="model_description">
		  <xsd:complexType>
			<xsd:sequence>
			  <xsd:element name="top_layer" maxOccurs="1">
				<xsd:complexType>
				  <xsd:sequence>
					<xsd:element name="name" type="xsd:string" default="top"/>
					<xsd:element name="reservoir_endmember">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="name" type="xsd:string" default="reference sand"/>
						  <xsd:element name="brine" minOccurs="1">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="brine"/>
								<xsd:element name="rho_brine" minOccurs="0" type="varFloat" default="1.0"/>
								<xsd:element name="sigma_rho_brine" minOccurs="0" type="varFloat" default="0"/>
								<xsd:element name="vp_brine" minOccurs="0" type="varFloat" default="1.0"/>
								<xsd:element name="sigma_vp_brine" minOccurs="0" type="varFloat" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="oil" minOccurs="0">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="oil A"/>
								<xsd:element name="probability_of_oil" type="varFloat" default="0.2"/>
								<xsd:element name="saturation_of_oil" type="varVinOrderFloat" maxOccurs="unbounded" default="0.7"/>
								<xsd:element name="sigma_saturation_of_oil" type="varVinFloat" minOccurs="0" maxOccurs="unbounded" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="gas" minOccurs="0">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="gas A"/>
								<xsd:element name="probability_of_gas" type="varFloat" default="0.2"/>
								<xsd:element name="saturation_of_gas" type="varVinOrderFloat" maxOccurs="unbounded" default="0.8"/>
								<xsd:element name="sigma_saturation_of_gas" type="varVinFloat" minOccurs="0" maxOccurs="unbounded" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="lsg" minOccurs="0">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="gas A"/>
								<xsd:element name="probability_of_lsg" type="varFloat" default="0.2"/>
								<xsd:element name="saturation_of_lsg" type="varVinFloat" maxOccurs="unbounded" default="0.15"/>
								<xsd:element name="sigma_saturation_of_lsg" type="varVinFloat" minOccurs="0" maxOccurs="unbounded" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <!-- JG: CHANGE float_fraction can be synchronised -->
						  <xsd:element name="float_fraction" minOccurs="0" type="varFloat" default="0.0"/>
						  <xsd:element name="sigma_float_fraction" minOccurs="0" type="varFloat" default="0"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<xsd:element name="nonreservoir_endmember">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="name" type="xsd:string" default="reference shale"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>

					<!-- JG hard rocks. Can be absent -->
					<xsd:element name="nonreservoir_hard_endmember" minOccurs="0">
					  <xsd:complexType>
						<xsd:sequence>	
						  <xsd:choice>
							<xsd:element name="fluid_dependent_nonreservoir_hard_endmembers">
							  <xsd:complexType>
								<xsd:sequence>
								  <xsd:element name="brine_case" type="xsd:string" default="hard_rock_A"/>
								  <xsd:element name="gas_case" type="xsd:string" default="hard_rock_B" minOccurs="0"/>	
								  <xsd:element name="oil_case" type="xsd:string" default="hard_rock_C" minOccurs="0"/>
								  <xsd:element name="lsg_case" type="xsd:string" default="hard_rock_D" minOccurs="0"/>
								</xsd:sequence>
							  </xsd:complexType>
							</xsd:element>
							<xsd:element name="nonreservoir_hard_endmember">
							  <xsd:complexType>
								<xsd:sequence>
								  <xsd:element name="name" type="xsd:string" default="hard_rock_A" />
								</xsd:sequence>	
							  </xsd:complexType>
							</xsd:element>
						  </xsd:choice>
						  <xsd:element name="net_to_gross_hard" type="varFloat" default="0.0"/>
						  <xsd:element name="sigma_net_to_gross_hard" minOccurs="0" type="varFloat" default="0"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>

					<xsd:element name="time" type="varFloat" default="0"/>
					<xsd:element name="sigma_time" type="varFloat" default="10"/>
					<xsd:element name="net_to_gross" type="varFloat" default="0.0"/>
					<xsd:element name="sigma_net_to_gross" minOccurs="0" type="varFloat" default="0"/>
					<xsd:element name="depth" type="varFloat" default="0"/>
					<xsd:element name="sigma_depth" minOccurs="0" type="varFloat" default="0"/>
					<xsd:element name="depth_rock_curves" minOccurs="0" type="varFloat" default="0"/>
					<xsd:element name="LFIV" type="varFloat" default="8000"/>
					<xsd:element name="sigma_LFIV" minOccurs="0" type="varFloat" default="0"/>
					<xsd:element name="thickness" minOccurs="0" type="varFloat" default="100"/>
					<xsd:element name="sigma_thickness" minOccurs="0" type="varFloat" default="0"/>
				
					<xsd:element name="time_lapse_specification" minOccurs="1" maxOccurs="1">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="stress_correlation_coefficient" minOccurs="1" type="xsd:float" default="0"  maxOccurs="1"/>
						  <xsd:element name="reference_layer_time_lapse_priors" minOccurs="0" maxOccurs="1" type="vintageStressAndTimeList"/>					
						</xsd:sequence>	
					  </xsd:complexType>	
					</xsd:element>
				  </xsd:sequence>

				  <xsd:attribute name="synchronise_rock_matrix" type="xsd:boolean" default="false"/>				  
				</xsd:complexType>
			  </xsd:element>

			  <xsd:element name="middle_layer" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
				  <xsd:sequence>
					<xsd:element name="name" type="xsd:string" default="middle"/>
					<xsd:element name="reservoir_endmember">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="name" type="xsd:string" default="reference sand"/>
						  <xsd:element name="brine" minOccurs="1">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="brine"/>
								<xsd:element name="rho_brine" minOccurs="0" type="varFloat" default="1.0"/>
								<xsd:element name="sigma_rho_brine" minOccurs="0" type="varFloat" default="0"/>
								<xsd:element name="vp_brine" minOccurs="0" type="varFloat" default="1.0"/>
								<xsd:element name="sigma_vp_brine" minOccurs="0" type="varFloat" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="oil" minOccurs="0">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="oil A"/>
								<xsd:element name="probability_of_oil" type="varFloat" default="0.2"/>
								<xsd:element name="saturation_of_oil" type="varVinOrderFloat" maxOccurs="unbounded" default="0.7"/>
								<xsd:element name="sigma_saturation_of_oil" type="varVinFloat" minOccurs="0" maxOccurs="unbounded" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="gas" minOccurs="0">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="gas A"/>
								<xsd:element name="probability_of_gas" type="varFloat" default="0.2"/>
								<xsd:element name="saturation_of_gas" type="varVinOrderFloat" maxOccurs="unbounded" default="0.8"/>
								<xsd:element name="sigma_saturation_of_gas" type="varVinFloat" minOccurs="0" maxOccurs="unbounded" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="lsg" minOccurs="0">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="gas A"/>
								<xsd:element name="probability_of_lsg" type="varFloat" default="0.2"/>
								<xsd:element name="saturation_of_lsg" type="varVinFloat" maxOccurs="unbounded" default="0.15"/>
								<xsd:element name="sigma_saturation_of_lsg" type="varVinFloat" minOccurs="0" maxOccurs="unbounded" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="float_fraction" minOccurs="0" type="vsFloat" default="0.0"/>
						  <xsd:element name="sigma_float_fraction" minOccurs="0" type="vsFloat" default="0"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<xsd:element name="nonreservoir_endmember">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="name" type="xsd:string" default="reference shale"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<!-- JG hard rocks. Can be absent -->
					<xsd:element name="nonreservoir_hard_endmember" minOccurs="0">
					  <xsd:complexType>
						<xsd:sequence>	
						  <xsd:choice>
							<xsd:element name="fluid_dependent_nonreservoir_hard_endmembers">
							  <xsd:complexType>
								<xsd:sequence>
								  <xsd:element name="brine_case" type="xsd:string" default="hard_rock_A"/>
								  <xsd:element name="gas_case" type="xsd:string" default="hard_rock_B" minOccurs="0"/>	
								  <xsd:element name="oil_case" type="xsd:string" default="hard_rock_C" minOccurs="0"/>
								  <xsd:element name="lsg_case" type="xsd:string" default="hard_rock_D" minOccurs="0"/>
								</xsd:sequence>
							  </xsd:complexType>
							</xsd:element>
							<xsd:element name="nonreservoir_hard_endmember">
							  <xsd:complexType>
								<xsd:sequence>
								  <xsd:element name="name" type="xsd:string" default="hard_rock_A" />
								</xsd:sequence>	
							  </xsd:complexType>
							</xsd:element>
						  </xsd:choice>
						  <xsd:element name="net_to_gross_hard" type="varFloat" default="0.0"/>
						  <xsd:element name="sigma_net_to_gross_hard" minOccurs="0" type="varFloat" default="0"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>

					<xsd:element name="time" type="vsFloat" default="0"/>
					<xsd:element name="sigma_time" type="varFloat" default="0"/>
					<xsd:element name="net_to_gross" type="vsFloat" default="0.0"/>
					<xsd:element name="sigma_net_to_gross" minOccurs="0" type="varFloat" default="0"/>
					<xsd:element name="depth" type="vsFloat" default="0"/>
					<xsd:element name="sigma_depth" minOccurs="0" type="vsFloat" default="0"/>
					<xsd:element name="depth_rock_curves" minOccurs="0" type="varFloat" default="0"/>
					<xsd:element name="LFIV" type="vsFloat" default="8000"/>
					<xsd:element name="sigma_LFIV" minOccurs="0" type="vsFloat" default="0"/>
					<xsd:element name="thickness" minOccurs="0" type="vsFloat" default="100"/>
					<xsd:element name="sigma_thickness" minOccurs="0" type="varFloat" default="50"/>

					<xsd:element name="time_lapse_specification" minOccurs="1" maxOccurs="1">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="stress_correlation_coefficient" minOccurs="1" type="xsd:float" default="0"  maxOccurs="1"/>
						  <xsd:element name="reference_layer_time_lapse_priors" minOccurs="0" maxOccurs="1" type="vintageStressAndTimeList"/>												  
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
				  </xsd:sequence>
				  <xsd:attribute name="synchronise_rock_matrix" type="xsd:boolean" default="false"/>
				</xsd:complexType>
			  </xsd:element>

			  <xsd:element name="bottom_layer">
				<xsd:complexType>
				  <xsd:sequence>
					<xsd:element name="name" type="xsd:string" default="bottom"/>
					<xsd:element name="reservoir_endmember">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="name" type="xsd:string" default="reference sand"/>
						  <xsd:element name="brine" minOccurs="1">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="brine"/>
								<xsd:element name="rho_brine" minOccurs="0" type="varFloat" default="1.0"/>
								<xsd:element name="sigma_rho_brine" minOccurs="0" type="varFloat" default="0"/>
								<xsd:element name="vp_brine" minOccurs="0" type="varFloat" default="1.0"/>
								<xsd:element name="sigma_vp_brine" minOccurs="0" type="varFloat" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="oil" minOccurs="0">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="oil A"/>
								<xsd:element name="probability_of_oil" type="varFloat" default="0.2"/>
								<xsd:element name="saturation_of_oil" type="varVinOrderFloat" maxOccurs="unbounded" default="0.7"/>
								<xsd:element name="sigma_saturation_of_oil" type="varVinFloat" minOccurs="0" maxOccurs="unbounded" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="gas" minOccurs="0">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="gas A"/>
								<xsd:element name="probability_of_gas" type="varFloat" default="0.2"/>
								<xsd:element name="saturation_of_gas" type="varVinOrderFloat" maxOccurs="unbounded" default="0.8"/>
								<xsd:element name="sigma_saturation_of_gas" type="varVinFloat" minOccurs="0" maxOccurs="unbounded" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="lsg" minOccurs="0">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="name" type="xsd:string" default="gas A"/>
								<xsd:element name="probability_of_lsg" type="varFloat" default="0.2"/>
								<xsd:element name="saturation_of_lsg" type="varVinFloat" maxOccurs="unbounded" default="0.15"/>
								<xsd:element name="sigma_saturation_of_lsg" type="varVinFloat" minOccurs="0" maxOccurs="unbounded" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="float_fraction" minOccurs="0" type="vsFloat" default="0.0"/>
						  <xsd:element name="sigma_float_fraction" minOccurs="0" type="vsFloat" default="0"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<xsd:element name="nonreservoir_endmember">
					  <xsd:complexType>
 						<xsd:sequence>
						  <xsd:element name="name" type="xsd:string" default="reference shale"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<!-- JG hard rocks. Can be absent -->
					<xsd:element name="nonreservoir_hard_endmember" minOccurs="0">
					  <xsd:complexType>
						<xsd:sequence>	
						  <xsd:choice>
							<xsd:element name="fluid_dependent_nonreservoir_hard_endmembers">
							  <xsd:complexType>
								<xsd:sequence>
								  <xsd:element name="brine_case" type="xsd:string" default="hard_rock_A"/>
								  <xsd:element name="gas_case" type="xsd:string" default="hard_rock_B" minOccurs="0"/>	
								  <xsd:element name="oil_case" type="xsd:string" default="hard_rock_C" minOccurs="0"/>
								  <xsd:element name="lsg_case" type="xsd:string" default="hard_rock_D" minOccurs="0"/>
								</xsd:sequence>
							  </xsd:complexType>
							</xsd:element>
							<xsd:element name="nonreservoir_hard_endmember">
							  <xsd:complexType>
								<xsd:sequence>
								  <xsd:element name="name" type="xsd:string" default="hard_rock_A" />
								</xsd:sequence>	
							  </xsd:complexType>
							</xsd:element>
						  </xsd:choice>
						  <xsd:element name="net_to_gross_hard" type="varFloat" default="0.0"/>
						  <xsd:element name="sigma_net_to_gross_hard" minOccurs="0" type="varFloat" default="0"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<xsd:element name="time" type="vsFloat" default="0"/>
					<xsd:element name="sigma_time" type="varFloat" default="0"/>
					<xsd:element name="net_to_gross" type="vsFloat" default="0.0"/>
					<xsd:element name="sigma_net_to_gross" minOccurs="0" type="varFloat" default="0"/>
					<xsd:element name="depth" type="vsFloat" default="0"/>
					<xsd:element name="sigma_depth" minOccurs="0" type="vsFloat" default="0"/>
					<xsd:element name="depth_rock_curves" minOccurs="0" type="varFloat" default="0"/>
					<xsd:element name="LFIV" type="vsFloat" default="8000"/>
					<xsd:element name="sigma_LFIV" minOccurs="0" type="vsFloat" default="0"/>
					<xsd:element name="thickness" minOccurs="0" type="vsFloat" default="100"/>
					<xsd:element name="sigma_thickness" minOccurs="0" type="varFloat" default="50"/>
					<xsd:element name="t_base" type="varFloat" default="0"/>
					<xsd:element name="sigma_t_base" type="varFloat" default="10"/>

					<xsd:element name="time_lapse_specification" minOccurs="1" maxOccurs="1">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="stress_correlation_coefficient" minOccurs="1" type="xsd:float" default="0"  maxOccurs="1"/>
						  <xsd:element name="reference_layer_time_lapse_priors" minOccurs="0" maxOccurs="1" type="vintageStressAndTimeList"/>					
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
				  </xsd:sequence>
				  <xsd:attribute name="synchronise_rock_matrix" type="xsd:boolean" default="false"/>
				</xsd:complexType>
			  </xsd:element>

			  <xsd:element name="stacked_models_info" minOccurs="0" maxOccurs="1">
				<xsd:complexType>
				  <xsd:sequence>
					<xsd:element name="layer_mappings" maxOccurs="1">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="mapping" type="xsd:string" default="1:5" minOccurs="1" maxOccurs="unbounded"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<xsd:element name="property_difference_std_deviations" maxOccurs="1">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="vp_m" type="appString" default="500" minOccurs="0" maxOccurs="1"/>
						  <xsd:element name="vs_m" type="appString" default="500" minOccurs="0" maxOccurs="1"/>
						  <xsd:element name="rho_m" type="appString" default="0.1" minOccurs="0" maxOccurs="1"/>
						  <xsd:element name="vp_s" type="appString" default="500" minOccurs="0" maxOccurs="1"/>
						  <xsd:element name="vs_s" type="appString" default="500" minOccurs="0" maxOccurs="1"/>
						  <xsd:element name="phi_s" type="appString" default="0.1" minOccurs="0" maxOccurs="1"/>
						  <xsd:element name="NG" type="appString" default="0.1" minOccurs="0" maxOccurs="1"/>
						  <xsd:element name="thickness" type="appString" default="100" minOccurs="0" maxOccurs="1"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<xsd:element name="seismic_likelihood_exclusion_range" maxOccurs="unbounded">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="start_layer" type="xsd:positiveInteger" default="1"/>
						  <xsd:element name="end_layer" type="xsd:positiveInteger" default="1"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
				  </xsd:sequence>
				</xsd:complexType> 
			  </xsd:element> 

			</xsd:sequence>
		  </xsd:complexType>
		</xsd:element>

		<xsd:element name="fluid_units_and_contacts" minOccurs="0" maxOccurs="1">
		  <xsd:complexType>
			<xsd:sequence>
			  <xsd:element name="fluid_unit" minOccurs="1" maxOccurs="unbounded">
				<xsd:complexType>
				  <xsd:sequence>
					<xsd:element name="top_layer" type="xsd:string" default="1" minOccurs="1" maxOccurs="1"/>
					<xsd:element name="bottom_layer" type="xsd:string" default="2" minOccurs="1" maxOccurs="1"/>
					<xsd:element name="vintage" minOccurs="1" maxOccurs="unbounded">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="contact" minOccurs="1" maxOccurs="3">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="type" type="contactString" default="OB"/>
								<xsd:element name="depth" type="varVinOrderFloat" default="1000"/>
								<xsd:element name="sigma_depth" type="varFloat" default="0"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						</xsd:sequence>
<!-- don't use this...
					  <xsd:attribute name="vintage" type="xsd:positiveInteger" default="1"/>	
-->
					  </xsd:complexType>
					</xsd:element>
				  </xsd:sequence>
				  <xsd:attribute name="fluid_properties_synchronised" type="xsd:boolean" default="false"/>
				</xsd:complexType>
			  </xsd:element>
			</xsd:sequence>
		  </xsd:complexType> 
		</xsd:element> 

		<xsd:element name="rock_fluid_properties">
		  <xsd:complexType>
			<xsd:sequence>
			  <xsd:element name="fluid_properties">
				<xsd:complexType>
				  <xsd:sequence>
					<xsd:element name="fluid" maxOccurs="unbounded">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="name" type="xsd:string" default="brine"/>
						  <xsd:element name="vp" type="varFloat" default="1450"/>
						  <xsd:element name="sigma_vp" minOccurs="0" type="varFloat" default="0"/>
						  <xsd:element name="rho" type="varFloat" default="1.01"/>
						  <xsd:element name="sigma_rho" minOccurs="0" type="varFloat" default="0"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
				  </xsd:sequence>
				</xsd:complexType>
			  </xsd:element>
			  <xsd:element name="rock_properties">
				<xsd:complexType>
				  <xsd:sequence>
					<xsd:element name="reservoir_endmember" maxOccurs="unbounded">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="name" type="xsd:string" default="reference sand"/>
						  <xsd:element name="reference_fluid" type="xsd:string" default="brine"/>
						  <xsd:element name="vp_curve">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="intercept" type="varFloat" default="3600"/>
								<xsd:element name="depth_coefficient" type="varFloat" default="0"/> 
								<xsd:element name="LFIV_coefficient" type="varFloat" default="0"/>
								<xsd:element name="phi_float_coefficient" minOccurs="0" type="varFloat" default="0"/>
								<xsd:element name="sigma" type="varFloat" default="200"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="vs_curve">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="intercept" type="varFloat" default="2100"/>
								<xsd:element name="slope" type="varFloat" default="0"/>
								<xsd:element name="sigma" type="varFloat" default="160"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="porosity_curve">
							<xsd:complexType>
							  <xsd:sequence>	
								<xsd:element name="intercept" type="varFloat" default="0.25"/>
								<xsd:element name="slope" type="varFloat" default="0"/>
								<xsd:element name="phi_float_coefficient" minOccurs="0" type="varFloat" default="0"/>
								<xsd:element name="sigma" type="varFloat" default="0.02"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="vp_grain" type="varFloat" default="6050"/>
						  <xsd:element name="vs_grain" type="varFloat" default="4090"/>
						  <xsd:element name="rho_grain" type="varFloat" default="2.65"/>
						  <xsd:element name="stress_path_coefficients" type="stressPathCoeffType"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
					<xsd:element name="nonreservoir_endmember" maxOccurs="unbounded">
					  <xsd:complexType>
						<xsd:sequence>
						  <xsd:element name="name" type="xsd:string" default="reference shale"/>
						  <xsd:element name="vp_curve">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="intercept" type="varFloat" default="3810"/>
								<xsd:element name="depth_coefficient" type="varFloat" default="0"/>
								<xsd:element name="LFIV_coefficient" type="varFloat" default="0"/>
								<xsd:element name="sigma" type="varFloat" default="200"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="vs_curve">
							<xsd:complexType>
							  <xsd:sequence>
								<xsd:element name="intercept" type="varFloat" default="1880"/>
								<xsd:element name="slope" type="varFloat" default="0"/>
								<xsd:element name="sigma" type="varFloat" default="150"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="density_curve">
							<xsd:complexType>
							  <xsd:sequence>	
								<xsd:element name="factor" type="varFloat" default="2.5"/>
								<xsd:element name="exponent" type="varFloat" default="0"/>
								<xsd:element name="sigma" type="varFloat" default="0.02"/>
							  </xsd:sequence>
							</xsd:complexType>
						  </xsd:element>
						  <xsd:element name="stress_path_coefficients" type="stressPathCoeffType"/>
						</xsd:sequence>
					  </xsd:complexType>
					</xsd:element>
				  </xsd:sequence>
				</xsd:complexType>
			  </xsd:element>
			</xsd:sequence>
		  </xsd:complexType>
		</xsd:element>
		<xsd:element name="output">
		  <xsd:complexType>
			<xsd:sequence>
			  <xsd:element name="density_ordering" default="full">
				<xsd:simpleType>
				  <xsd:restriction base="xsd:string">
                    <xsd:enumeration value="full"/>
                    <xsd:enumeration value="partial"/>
                    <xsd:enumeration value="none"/>
                  </xsd:restriction>
                </xsd:simpleType>
			  </xsd:element> 
			  <xsd:element name="take_fluid_probabilities_as_post_ordering" minOccurs="0" type="xsd:boolean" default="false"/>	
			  <xsd:element name="realisation_number_header_field" type="xsd:string" default="mark"/>
			  <xsd:element name="depth_models" type="xsd:boolean" default="false"/>
			  <xsd:element name="master_depth_layer_number" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="properties" minOccurs="0" maxOccurs="1">
				<xsd:complexType>
				  <xsd:attribute name="d" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="LFIV" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="NG" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="vp_m" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="vs_m" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="rho_m" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="vp_s" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="vs_s" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="phi_s" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="S_h" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="rho_h" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="fluid_type" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="vp_eff" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="rho_eff" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="Z_eff" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="seismic_chisquare" type="xsd:boolean" default="true"/>
				  <xsd:attribute name="float_fraction" type="xsd:boolean" default="true"/>
				</xsd:complexType>
			  </xsd:element>
			</xsd:sequence>
		  </xsd:complexType>
		</xsd:element>
		<xsd:element name="property_indices">
		  <xsd:complexType>
			<xsd:sequence>  <!-- change to any order -->
			  <xsd:element name="stack_noise_rms_link" minOccurs="0" maxOccurs="unbounded" type="slinkInt" default="1"/>

			  <xsd:element name="min_offset_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="max_offset_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="reflector_time_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="stack_velocity_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>

			  <xsd:element name="time_above_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="time_below_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="A_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_A_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="B_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_B_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="rho_brine_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_rho_brine_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="vp_brine_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_vp_brine_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="probability_of_oil_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="probability_of_gas_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="probability_of_lsg_link" minOccurs="0" type="xsd:positiveInteger" default="1"/> 
			  
			  <!-- 4D vintage-specific things -->
			  <xsd:element name="saturation_of_oil_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkInt"/>
			  <xsd:element name="saturation_of_gas_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkInt"/>
			  <xsd:element name="saturation_of_lsg_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkInt"/>
			  <xsd:element name="sigma_saturation_of_oil_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkInt"/>
			  <xsd:element name="sigma_saturation_of_gas_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkInt"/> 
			  <xsd:element name="sigma_saturation_of_lsg_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkInt"/>
			  <xsd:element name="contact_depth_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkIntFC"/>
			  <xsd:element name="sigma_contact_depth_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkIntFC"/>
			  <xsd:element name="delta_pore_pressure_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkInt"/>
			  <xsd:element name="sigma_delta_pore_pressure_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkInt"/>
			  <xsd:element name="sigma_time_shift_link" default="1" minOccurs="0" maxOccurs="unbounded" type="clinkInt"/>
			  
			  <xsd:element name="float_fraction_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_float_fraction_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="net_to_gross_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_net_to_gross_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="net_to_gross_hard_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_net_to_gross_hard_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>

			  <xsd:element name="time_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_time_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="depth_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_depth_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>

			  <xsd:element name="depth_rock_curves_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_depth_rock_curves_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="LFIV_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_LFIV_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="thickness_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			  <xsd:element name="sigma_thickness_link" minOccurs="0" type="xsd:positiveInteger" default="1"/>
			</xsd:sequence>
		  </xsd:complexType>
		</xsd:element>
      </xsd:sequence>
    </xsd:complexType> 
  </xsd:element> 
</xsd:schema>
