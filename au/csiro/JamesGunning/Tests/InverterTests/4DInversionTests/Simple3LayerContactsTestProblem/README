# A simple test model with 3 layers and 2 contacts to demonstrate
# contact-in-depth operation mode in Delivery4D.
# Time lapse contacts are lifted about 20m in depth to model effect of rising contacts under production

# Make prior model:

./make_contact_model.pl
delivery4D -v 3  -p -m prior_traces.su ModelDescription.xml -II --make-synthetic 40 4 1.9 2.4
# copy synthetics to make named data in XML
# note new suffix format synthetic_stack.V_p.S_q.su for vintage p, stack q...
mv synthetic_stack.V_1.S_1.su near_stack.V1.su
mv synthetic_stack.V_1.S_2.su far_stack.V1.su
mv synthetic_stack.V_2.S_1.su near_stack.V2.su
mv synthetic_stack.V_2.S_2.su far_stack.V2.su

# see seismic 
cat near_stack.V1.su |  suxwigb x1beg=2 x1end=2.3
# see effects of moving contacts (wiggle plot of vintage1,vintage2, superposed)
cat near_stack.V1.su cat near_stack.V2.su |  suxwigb key=tracl va=0 &

# see model in time (all -G commands below can be replaced using 
# some kind of SU capture of stdout)
delivery4D -v 3 -p -m prior_traces.su ModelDescription.xml -II 
deliveryAnalyser4D -i realisations.su --layer 1.8 2.5 -l -G

# see model in depth

deliveryAnalyser4D -i realisations.su -ldepth --layer 1.8 2.3 -l -G


# Draws from prior:
delivery4D -v 3 -PD -N 100 -IS -m prior_traces.su ModelDescription.xml

# Inversions:
# MAP:
delivery4D -v 3 -m prior_traces.su ModelDescription.xml --MAP

# realisations
delivery4D -v 3 -m prior_traces.su ModelDescription.xml -RWS -N 500 --no-descent-test

# see posterior realisations, fluid-colored, vintage 1, in depth from above
deliveryAnalyser4D -i realisations.su -ldepth --layer 1.8 2.3 -lf -V 1 -G

# see posterior realisations, fluid-colored, vintage 2, in time 
deliveryAnalyser4D -i realisations.su -lf -V 2 -G

# near-stack spaghetti plots, vintage 2, underneath true seismic
deliveryAnalyser4D -i realisations.su -S 1.9 2.4 R_pp,2:1 wavelet.su near_stack.V2.su -G 

# posterior oil saturation, p50 quantile, layer 2, vintage 1
deliveryAnalyser4D -i realisations.su --quantile S_oil,1 2 50

# Check of preservation of layer properties between vintages 
# Note: no stress effects in this model,
# no Gassmann effects in shales, preserved thicknesses
deliveryAnalyser4D -i realisations.su -p-ascii2-gen vp_m,1 vp_m,2 1 1 -G
deliveryAnalyser4D -i realisations.su -p-ascii2-gen thickness,1 thickness,2 2 2 -G
deliveryAnalyser4D -i realisations.su -p-ascii2-gen NG,1 NG,2 2 2 -G
