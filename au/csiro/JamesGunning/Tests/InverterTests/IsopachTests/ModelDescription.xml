      <sigma_t_base varies_areally="false">5</sigma_t_base>
    </bottom_layer>
  </model_description>
  <rock_fluid_properties>
    <fluid_properties>
      <fluid>
        <name>brine</name>
        <vp varies_areally="false">5600</vp>
        <rho varies_areally="false">1.05</rho>
      </fluid>
    </fluid_properties>
    <rock_properties>
      <reservoir_endmember>
        <name>reference sand</name>
        <reference_fluid>brine</reference_fluid>
        <vp_curve>
          <!-- terms in a linear regression -->
          <intercept>4320</intercept>
          <depth_coefficient>0.33</depth_coefficient>
          <LFIV_coefficient>0</LFIV_coefficient>
          <sigma>250</sigma>
        </vp_curve>
        <vs_curve>
          <!-- terms in a linear regression -->
          <intercept>-2930</intercept>
          <slope>0.75</slope>
          <sigma>190</sigma>
        </vs_curve>
        <porosity_curve>
          <!-- terms in a linear regression -->
          <intercept>0.48</intercept>
          <slope varies_areally="false">-1.9E-5</slope>
          <sigma>0.018</sigma>
        </porosity_curve>
        <vp_grain varies_areally="false">20166</vp_grain>
        <vs_grain varies_areally="false">13633</vs_grain>
        <rho_grain>2.65</rho_grain>
      </reservoir_endmember>
      <nonreservoir_endmember>
        <name>reference shale</name>
        <vp_curve>
          <!-- terms in a linear regression -->
          <intercept>4640</intercept>
          <depth_coefficient>0.33</depth_coefficient>
          <LFIV_coefficient>0</LFIV_coefficient>
          <sigma>470</sigma>
        </vp_curve>
        <vs_curve>
          <!-- terms in a linear regression -->
          <intercept>-1630</intercept>
          <slope>0.57</slope>
          <sigma>140</sigma>
        </vs_curve>
        <density_curve>
          <!-- terms in a Gardner-Gardner-Grogery type regression -->
          <factor>0.22</factor>
          <exponent>0.26</exponent>
          <sigma>0.02</sigma>
        </density_curve>
      </nonreservoir_endmember>
    </rock_properties>
  </rock_fluid_properties>
  <output>
    <!-- FLAG to indicate density ordering for fluids -->
    <!-- This must be one of {none,partial,full} -->
    <!-- "full" =fluids are density-ordered in permeable layers for the full -->
    <!--        extent of the model, even if two permeable layers are separated byan impermeable layer -->
    <!-- "partial" = fluids are density-ordered in adjacent permeable layers not separated by an impermeable layer -->
    <!-- "none" = all fluids are allowed in all layers, irrespective of density -->
    <density_ordering>full</density_ordering>
    <realisation_number_header_field>mark</realisation_number_header_field>
    <depth_models>false</depth_models>
    <master_depth_layer_number>1</master_depth_layer_number>
  </output>
  
<property_indices>
    <net_to_gross_link>4</net_to_gross_link><time_link>5</time_link>
    <depth_link>3</depth_link>
    <thickness_link>2</thickness_link>
  </property_indices>
</inversion>
