      <name>top (1,0)</name>
      <reservoir_endmember>
        <name>reference sand</name>
        <brine>
          <name>brine</name>
        </brine>
      </reservoir_endmember>
      <nonreservoir_endmember>
        <name>reference shale</name>
      </nonreservoir_endmember>
      <time varies_areally="false">1800</time>
      <sigma_time varies_areally="false">5</sigma_time>
      <net_to_gross>0.0</net_to_gross>
      <depth varies_areally="false">13850</depth>
      <sigma_depth varies_areally="false">0</sigma_depth>
      <LFIV varies_areally="false">0</LFIV>
    </top_layer>
    <middle_layer>
      <name>reservoir</name>
      <reservoir_endmember>
        <name>reference sand</name>
        <brine>
          <name>brine</name>
        </brine>
      </reservoir_endmember>
      <nonreservoir_endmember>
        <name>reference shale</name>
      </nonreservoir_endmember>
      <time varies_areally="false" same_as_layer_above="false">1920</time>
      <sigma_time varies_areally="false">5</sigma_time>
      <net_to_gross varies_areally="false" same_as_layer_above="false">1</net_to_gross>
      <depth varies_areally="false" same_as_layer_above="false">13900</depth>
      <sigma_depth varies_areally="false" same_as_layer_above="false">0</sigma_depth>
      <LFIV varies_areally="false" same_as_layer_above="false">0</LFIV>
      <thickness varies_areally="false" same_as_layer_above="false">40</thickness>
      <sigma_thickness varies_areally="false">1</sigma_thickness>
    </middle_layer>
    <bottom_layer>
      <name>bottom</name>
      <reservoir_endmember>
        <name>reference sand</name>
        <brine>
          <name>brine</name>
        </brine>
      </reservoir_endmember>
      <nonreservoir_endmember>
        <name>reference shale</name>
      </nonreservoir_endmember>
