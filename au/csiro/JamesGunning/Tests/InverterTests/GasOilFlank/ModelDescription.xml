<?xml version="1.0" encoding="UTF-8"?>
<inversion>
  <inversion_info>
    <name>BrineOilGasInFlankTest</name>
    <project>BrineOilGasInFlankTest</project>
    <author>Gunning</author>
  </inversion_info>
  <seismic_data>
    <stack>
      <name>near</name>
      <filename>near-stack.su</filename>
      <min_offset>0</min_offset>
      <max_offset varies_areally="false">1200</max_offset>
      <reflector_time varies_areally="false">1800</reflector_time>
      <stack_velocity varies_areally="false">2200</stack_velocity>
      <wavelet>
        <filename>near-wavelet.su</filename>
        <noise_rms>0.015</noise_rms>  <!-- cf peak amplitude is ~ 0.15 -->
      </wavelet>
    </stack>
    <stack>
      <name>far</name>
      <filename>far-stack.su</filename>
      <min_offset varies_areally="false">1500</min_offset>
      <max_offset varies_areally="false">3000</max_offset>
      <reflector_time varies_areally="false">1800</reflector_time>
      <stack_velocity varies_areally="false">2200</stack_velocity>
      <wavelet>
        <filename>far-wavelet.su</filename>
        <noise_rms varies_areally="false">100</noise_rms>
      </wavelet>
    </stack>
    <AVO_terms>
      <A>1.0</A>
      <B>1.0</B>
    </AVO_terms>
  </seismic_data>
  <model_description>
    
    <top_layer>
      <name>top (1,0)</name>
      <reservoir_endmember>
        <name>GOMsand</name>
        <brine>
          <name>brine</name>
        </brine>
      </reservoir_endmember>
      <nonreservoir_endmember>
        <name>GOMshale</name>
      </nonreservoir_endmember>
      <time varies_areally="true">1800</time>
      <sigma_time varies_areally="false">5</sigma_time>
      <net_to_gross>0.0</net_to_gross>
      <depth varies_areally="false">14000</depth>
      <sigma_depth varies_areally="false">0</sigma_depth>     
	  <LFIV varies_areally="false">0</LFIV>
	  <sigma_LFIV varies_areally="false">0</sigma_LFIV>
    </top_layer>

    <bottom_layer>
      <name>reservoir</name>
      <reservoir_endmember>
        <name>GOMsand</name>
      <brine>
          <name>brine</name>
        </brine>
        <oil>
          <name>oil</name>
          <probability_of_oil varies_areally="false">0.33</probability_of_oil>    <!-- set varies_areally:true to make truth case -->
          <saturation_of_oil varies_areally="false" same_as_layer_above="false">0.8</saturation_of_oil>
        </oil>
        <gas>
          <name>gas</name>
          <probability_of_gas varies_areally="false">0.33</probability_of_gas>   <!-- set varies_areally:true to make truth case -->
          <saturation_of_gas>0.8</saturation_of_gas>
        </gas>
      </reservoir_endmember>

      <nonreservoir_endmember>
        <name>GOMshale</name>
      </nonreservoir_endmember>
      <time varies_areally="true" same_as_layer_above="false">1920</time>
      <sigma_time varies_areally="false">20</sigma_time>      
      <net_to_gross varies_areally="false" same_as_layer_above="false">0.9</net_to_gross>
      <sigma_net_to_gross varies_areally="false">0.1</sigma_net_to_gross>
	  <depth varies_areally="false" same_as_layer_above="false">14000</depth>
      <sigma_depth varies_areally="false" same_as_layer_above="false">0</sigma_depth>
      <LFIV varies_areally="false" same_as_layer_above="false">2000</LFIV>
      <sigma_LFIV varies_areally="false" same_as_layer_above="false">0</sigma_LFIV>
      <t_base varies_areally="true">2100</t_base>
      <sigma_t_base varies_areally="false">6</sigma_t_base>
   </bottom_layer>
  </model_description>

  <rock_fluid_properties>
    <fluid_properties>   
	   <fluid>
        <name>brine</name>
        <vp varies_areally="false">6070</vp>
        <rho varies_areally="false">1.05</rho>
      </fluid>
      <fluid>
        <name>oil</name>
        <vp varies_areally="false">5600</vp> 
        <rho varies_areally="false">0.854</rho>
      </fluid>
      <fluid>
        <name>gas</name>
        <vp varies_areally="false">2000</vp>
        <rho varies_areally="false">0.2</rho>
      </fluid>

    </fluid_properties>

    <rock_properties>
    <reservoir_endmember>
        <name>GOMsand</name>
        <reference_fluid>brine</reference_fluid>
        <vp_curve>
          <intercept>4320</intercept>
          <depth_coefficient>0.33</depth_coefficient>
          <LFIV_coefficient>0</LFIV_coefficient>
          <sigma>250</sigma>
        </vp_curve>
        <vs_curve>
          <intercept>-2930</intercept>
          <slope>0.75</slope>
          <sigma>190</sigma>
        </vs_curve>
        <porosity_curve>
          <intercept>0.48</intercept> 
          <slope>-1.9E-5</slope>
          <sigma>0.018</sigma> 
        </porosity_curve>
        <vp_grain>20166</vp_grain>
        <vs_grain>13633</vs_grain>
        <rho_grain>2.65</rho_grain>
      </reservoir_endmember>

      <nonreservoir_endmember>
        <name>GOMshale</name>
        <vp_curve>
          <intercept>4640</intercept>
          <depth_coefficient>0.33</depth_coefficient>
          <LFIV_coefficient>0</LFIV_coefficient>
          <sigma>470</sigma>
        </vp_curve>
        <vs_curve>
          <intercept>-1630</intercept>
          <slope>0.57</slope>
          <sigma>140</sigma>
        </vs_curve>
        <density_curve>
          <factor>0.22</factor>
          <exponent>0.26</exponent>
          <sigma>0.02</sigma>
        </density_curve>
      </nonreservoir_endmember>

    </rock_properties>
  </rock_fluid_properties>
  <output>
    <density_ordering>full</density_ordering>
    <realisation_number_header_field>mark</realisation_number_header_field>
    <depth_models>false</depth_models>
    <master_depth_layer_number>1</master_depth_layer_number>
  </output>
  
  <property_indices>
	<probability_of_oil_link>1</probability_of_oil_link>
	<probability_of_gas_link>2</probability_of_gas_link>
	<time_link>4</time_link>	
  </property_indices>
</inversion>
