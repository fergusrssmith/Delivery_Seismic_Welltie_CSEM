<?xml version="1.0" encoding="UTF-8"?><wavelet_extraction>
  <wavelet_extraction_info>
    <name>BonnieHouseandBonnieHut</name>
    <project>AllBonnieThings</project>
    <author>James Gunning</author>
  </wavelet_extraction_info>
  <well_info>
	<well>
      <name>BonnieHouse</name>
      <well_log_info>
        <well_log_filename>BonnieHouse.las</well_log_filename>
        <measured_depth_keyword>DEPT</measured_depth_keyword>
        <sonic_DT_keyword>DTP</sonic_DT_keyword>
        <shear_sonic_DT_keyword>DTP</shear_sonic_DT_keyword>
        <density_keyword>DENSITY</density_keyword>
      </well_log_info>
      <well_survey_info>
        <well_survey_filename>BonnieHouseSurvey.txt</well_survey_filename>
        <total_vertical_depth_keyword>TVD</total_vertical_depth_keyword>
        <measured_depth_keyword>MD</measured_depth_keyword>
        <x_position_keyword>X</x_position_keyword>
        <y_position_keyword>Y</y_position_keyword>
      </well_survey_info>
      <checkshot_info>
        <checkshot_filename>BonnieHouseCheckshotVSP.txt</checkshot_filename>
        <checkshot_time_keyword>two-way-time</checkshot_time_keyword>
        <sigma_checkshot_time_keyword>Sigma_T</sigma_checkshot_time_keyword>
        <measured_depth_keyword>MD</measured_depth_keyword>
      </checkshot_info>
	  <seismic_stack_info>
        <seismic_minicube_filename>BonnieHouse_0_3sec.su</seismic_minicube_filename>
        <min_offset>0</min_offset>
        <max_offset>2200</max_offset>
        <reflector_time_ms>2300</reflector_time_ms>
        <stack_velocity>2300</stack_velocity>
        <time_to_depth_local_systematic_time_shift_mean_ms>0</time_to_depth_local_systematic_time_shift_mean_ms>
        <time_to_depth_local_systematic_time_shift_uncertainty_ms>10</time_to_depth_local_systematic_time_shift_uncertainty_ms>
      </seismic_stack_info>
	  <well_positioning_systematic_shift_uncertainty>
        <x_position_offset>0</x_position_offset>
        <y_position_offset>0</y_position_offset>
        <sigma_x_position>0</sigma_x_position>
        <sigma_y_position>0</sigma_y_position>
      </well_positioning_systematic_shift_uncertainty>
    </well>
	<well>
      <name>BonnieHut</name>
      <well_log_info>
        <well_log_filename>BonnieHut.las </well_log_filename>
        <measured_depth_keyword>DEPT</measured_depth_keyword>
        <sonic_DT_keyword>DTP</sonic_DT_keyword>
        <shear_sonic_DT_keyword>DTP</shear_sonic_DT_keyword>
        <density_keyword>DENSITY</density_keyword>
      </well_log_info>
      <well_survey_info>
        <well_survey_filename>BonnieHutSurvey.txt</well_survey_filename>
        <total_vertical_depth_keyword>TVD</total_vertical_depth_keyword>
        <measured_depth_keyword>MD</measured_depth_keyword>
        <x_position_keyword>X</x_position_keyword>
        <y_position_keyword>Y</y_position_keyword>
      </well_survey_info>
      <checkshot_info>
        <checkshot_filename>BonnieHutCheckshotVSP.txt</checkshot_filename>
        <checkshot_time_keyword>two-way-time</checkshot_time_keyword>
        <sigma_checkshot_time_keyword>Sigma_T</sigma_checkshot_time_keyword>
        <measured_depth_keyword>MD</measured_depth_keyword>
      </checkshot_info>
	  <seismic_stack_info>
        <seismic_minicube_filename>BonnieHut_0_3sec.su</seismic_minicube_filename>
        <min_offset>0</min_offset>
        <max_offset>2200</max_offset>
        <reflector_time_ms>2300</reflector_time_ms>
        <stack_velocity>2300</stack_velocity>
        <time_to_depth_local_systematic_time_shift_mean_ms>0</time_to_depth_local_systematic_time_shift_mean_ms>
        <time_to_depth_local_systematic_time_shift_uncertainty_ms>10</time_to_depth_local_systematic_time_shift_uncertainty_ms>
      </seismic_stack_info>
	  <well_positioning_systematic_shift_uncertainty>
        <x_position_offset>0</x_position_offset>
        <y_position_offset>0</y_position_offset>
        <sigma_x_position>0</sigma_x_position>
        <sigma_y_position>0</sigma_y_position>
      </well_positioning_systematic_shift_uncertainty>
    </well>
  </well_info>
  <extraction_info>
    <extraction_window_start_time>1.6</extraction_window_start_time>
    <extraction_window_end_time>2.25</extraction_window_end_time>
  </extraction_info>
  <wavelet_parameters>
    <maximum_coda_time_millis>40</maximum_coda_time_millis>
    <maximum_precursor_time_millis>40</maximum_precursor_time_millis>
  </wavelet_parameters>
  <seismic_minicube_header_words>
    <inline_header_keyword>cdp</inline_header_keyword>
    <xline_header_keyword>ep</xline_header_keyword>
    <X_header_keyword>gx</X_header_keyword>
    <Y_header_keyword>gy</Y_header_keyword>
  </seismic_minicube_header_words>
  <output>
    <maximum_likelihood_wavelet_filename>MLwavelet.MOST_LIKELY.stack.n.su</maximum_likelihood_wavelet_filename>
    <maximum_likelihood_parameters_filename>MLparameters.MOST_LIKELY.stack.n.su</maximum_likelihood_parameters_filename>
    <wavelet_realisations_filename>wavelet_realisations.su</wavelet_realisations_filename>
    <parameter_realisations_filename>parameter_realisations.su</parameter_realisations_filename>
    <blocked_log_file_prefix>blocked_</blocked_log_file_prefix>
    <realisation_number_header_field>mark</realisation_number_header_field>
  </output>
</wavelet_extraction>