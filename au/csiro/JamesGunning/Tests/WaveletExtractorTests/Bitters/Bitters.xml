<?xml version="1.0" encoding="UTF-8"?>
<wavelet_extraction>
  <wavelet_extraction_info>
    <name>Bitters1</name>
    <project>Bitters</project>
    <author>James Gunning</author>
  </wavelet_extraction_info>
  <well_info>
    
  <well>
      <name>Bitters1</name>
      <well_log_info>
        <well_log_filename>Bitters.las</well_log_filename>
        <measured_depth_keyword>DEPTH</measured_depth_keyword>
        <sonic_DT_keyword>DTC_BITTERS</sonic_DT_keyword>
        <shear_sonic_DT_keyword>DTS_BITTERS</shear_sonic_DT_keyword>
        <density_keyword>DEN_BITTERS</density_keyword>
      </well_log_info>
      <well_survey_info>
        <well_survey_filename>Bitters_Survey.txt</well_survey_filename>
        <total_vertical_depth_keyword>TVD</total_vertical_depth_keyword>
        <measured_depth_keyword>MD</measured_depth_keyword>
        <x_position_keyword>Absolute X</x_position_keyword>
        <y_position_keyword>Absolute Y</y_position_keyword>
      </well_survey_info>
      <checkshot_info>
        <checkshot_filename>Bitters_Checkshot.txt</checkshot_filename>
        <checkshot_time_keyword>Two Way Time</checkshot_time_keyword>
        <sigma_checkshot_time_keyword>Sigma_T</sigma_checkshot_time_keyword>
        <measured_depth_keyword>MD</measured_depth_keyword>
      </checkshot_info>
	  <seismic_stack_info>
        <seismic_minicube_filename>Bitters.near.su</seismic_minicube_filename>
        <min_offset>0</min_offset>
        <max_offset>200</max_offset>
        <reflector_time_ms>1500</reflector_time_ms>
        <stack_velocity>9514</stack_velocity>
        <time_to_depth_local_systematic_time_shift_mean_ms>0</time_to_depth_local_systematic_time_shift_mean_ms>
        <time_to_depth_local_systematic_time_shift_uncertainty_ms>5</time_to_depth_local_systematic_time_shift_uncertainty_ms>
        <two-D-utm-conversions set-two-D-geometry-from-XY-header-words="true">
		  <!-- setting set-two-D-geometry-from-XY-header-words here makes the code look at the -->
		  <!-- header words, so the points below are ignored. But if you don't have good header -->
		  <!-- words, this shows what to use. Note, inline/xline are usually more sensible numbers -->
		  <!-- and we usually have e.g. gx,gy for x,y in UTM's, inline/xline as cdp,ep -->
          <point>
            <x>762983</x>
            <y>1185046</y>
            <inline>762983</inline>
            <xline>1185046</xline>
          </point>
          <point>
            <x>763583</x>
            <y>1185046</y>
            <inline>763583</inline>
            <xline>1185046</xline>
          </point>
        </two-D-utm-conversions>
      </seismic_stack_info>
	  <seismic_stack_info>
        <seismic_minicube_filename>Bitters.far.su</seismic_minicube_filename>
        <min_offset>7000</min_offset>
        <max_offset>8000</max_offset>
        <reflector_time_ms>1500</reflector_time_ms>
        <stack_velocity>9514</stack_velocity>
        <time_to_depth_local_systematic_time_shift_mean_ms>0</time_to_depth_local_systematic_time_shift_mean_ms>
        <time_to_depth_local_systematic_time_shift_uncertainty_ms>5</time_to_depth_local_systematic_time_shift_uncertainty_ms>
        <two-D-utm-conversions set-two-D-geometry-from-XY-header-words="true">
          <!-- see comments above -->
		  <point>
            <x>762983</x>
            <y>1185046</y>
            <inline>762983</inline>
            <xline>1185046</xline>
          </point>
          <point>
            <x>763583</x>
            <y>1185046</y>
            <inline>763583</inline>
            <xline>1185046</xline>
          </point>
        </two-D-utm-conversions>
      </seismic_stack_info>
	  <well_positioning_systematic_shift_uncertainty>
        <x_position_offset>0</x_position_offset>
        <y_position_offset>0</y_position_offset>
        <sigma_x_position>0</sigma_x_position>
        <sigma_y_position>0</sigma_y_position>
      </well_positioning_systematic_shift_uncertainty>
      <AVO_terms_prior_distribution>
        <B_coefficient_prior_mean>1</B_coefficient_prior_mean>
        <B_coefficient_prior_std_deviation>0.1</B_coefficient_prior_std_deviation>
      </AVO_terms_prior_distribution>
    </well></well_info>
  
  
  <extraction_info>
    <extraction_window_start_time>1.41</extraction_window_start_time>
    <extraction_window_end_time>1.65</extraction_window_end_time> 
  </extraction_info><wavelet_parameters>
    <maximum_coda_time_millis>40</maximum_coda_time_millis>
    <maximum_precursor_time_millis>40</maximum_precursor_time_millis>
  </wavelet_parameters>
  <seismic_minicube_header_words>
    <inline_header_keyword>tracf</inline_header_keyword>
    <xline_header_keyword>fldr</xline_header_keyword>
    <X_header_keyword>tracf</X_header_keyword>
    <Y_header_keyword>fldr</Y_header_keyword>
  </seismic_minicube_header_words>
  <output>
    <maximum_likelihood_wavelet_filename>MLwavelet.MOST_LIKELY.stack.n.su</maximum_likelihood_wavelet_filename>
    <maximum_likelihood_parameters_filename>MLparameters.MOST_LIKELY.stack.n.su</maximum_likelihood_parameters_filename>
    <wavelet_realisations_filename>wavelet_realisations.su</wavelet_realisations_filename>
    <parameter_realisations_filename>parameter_realisations.su</parameter_realisations_filename>
    <blocked_log_file_prefix>blocked_</blocked_log_file_prefix>
    <realisation_number_header_field>mark</realisation_number_header_field>
  </output>
</wavelet_extraction>