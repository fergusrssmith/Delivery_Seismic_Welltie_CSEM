<?xml version="1.0" encoding="UTF-8"?>
<script>
  <parameters>
    <parameter>
      <name>initialize</name>
      <value>yes</value>
    </parameter>
    <parameter>
      <name>file</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name>input_directory</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">filelist</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">output_directory</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">output_filename</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">primary_key_name</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">primary_key_min_value</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">primary_key_increment</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">primary_key_number_bins</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">secondary_key_name</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">secondary_key_min_value</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">secondary_key_increment</name>
      <value>pvalue</value>
    </parameter>
    <parameter>
      <name substitution_string="">secondary_key_number_bins</name>
      <value>pvalue</value>
    </parameter>
  </parameters>
  <unix_command_P substitution_string="echo ${output_directory} "></unix_command_P>
  <P_file run_in_background="false" substitution_string="${output_directory}/${output_filename}.dat">myfile</P_file>
  <bhpio>
    <filename substitution_string="${output_filename}"></filename>
    <pathlist substitution_string="${output_directory}/${output_filename}.dat">myfile.dat</pathlist>
    <delete substitution_string="">yes</delete>
  </bhpio>
  <unix_command run_in_background="false" substitution_string="">for file in ${filelist}</unix_command>
  <unix_command run_in_background="false" substitution_string="">do</unix_command>
  <segyread>
    <tape substitution_string="${input_directory}/${file}">/dev/rmt0</tape>
  </segyread>
  <bhpwritecube>
    <filename substitution_string="${output_filename}">fname</filename>
    <init substitution_string="${initialize}">no</init>
    <pathlist substitution_string="${output_directory}/${output_filename}.dat">fname.dat</pathlist>
    <keys>
      <key>
        <header_word substitution_string="${primary_key_name}">fldr</header_word>
        <minimum_value substitution_string="${primary_key_min_value}">0</minimum_value>
        <increment substitution_string="${primary_key_increment}">1</increment>
        <number_of_bins substitution_string="${primary_key_number_bins}">1</number_of_bins>
      </key>
      <key>
        <header_word substitution_string="${secondary_key_name}">fldr</header_word>
        <minimum_value substitution_string="${secondary_key_min_value}">0</minimum_value>
        <increment substitution_string="${secondary_key_increment}">1</increment>
        <number_of_bins substitution_string="${secondary_key_number_bins}">1</number_of_bins>
      </key>
    </keys>
  </bhpwritecube>
  <unix_command run_in_background="false" substitution_string="">initialize=no</unix_command>
  <unix_command run_in_background="false" substitution_string="">done</unix_command>
</script>
