<?xml version="1.0" encoding="UTF-8"?>
<script>
  <parameters><parameter>
      <name>project_path</name>
      <value>/home/ahglim/disk152/brazil</value>
    </parameter><parameter>
      <name>mincdp</name>
      <value>124</value>
    </parameter><parameter>
      <name>inccdp</name>
      <value>1</value>
    </parameter><parameter>
      <name>ncdp</name>
      <value>1358</value>
    </parameter><parameter>
      <name>minep</name>
      <value>2200</value>
    </parameter><parameter>
      <name>incep</name>
      <value>1</value>
    </parameter><parameter>
      <name>nep</name>
      <value>310</value>
    </parameter><parameter>
      <name>input_filename</name>
      <value>hilb_seismic</value>
    </parameter><parameter>
      <name>output_filename</name>
      <value>landmark_horizons</value>
    </parameter><parameter>
      <name>event1_name</name>
      <value>lead1_peak</value>
    </parameter><parameter>
      <name>event2_name</name>
      <value>lead1_trough</value>
    </parameter><parameter>
      <name>event3_name</name>
      <value>lead1_amp</value>
    </parameter><parameter>
      <name>event4_name</name>
      <value>lead1_ampthick</value>
    </parameter><parameter>
      <name>event5_name</name>
      <value>frade_peak</value>
    </parameter><parameter>
      <name>event6_name</name>
      <value>frade_amp</value>
    </parameter><parameter>
      <name>event7_name</name>
      <value>ron_peak</value>
    </parameter><parameter>
      <name>event8_name</name>
      <value>ron_trough</value>
    </parameter><parameter>
      <name>event9_name</name>
      <value>ron_amp</value>
    </parameter><parameter>
      <name>event10_name</name>
      <value>east_peak</value>
    </parameter><parameter>
      <name>event11_name</name>
      <value>east_trough</value>
    </parameter><parameter>
      <name>event12_name</name>
      <value>east_amp</value>
    </parameter></parameters>
<unix_command run_in_background="false" substitution_string="cd ${project_path}"/><bhpio>
    <delete substitution_string="">yes</delete><pathlist substitution_string="int_datasets/${output_filename}.dat">myfile.dat</pathlist><filename substitution_string="${output_filename}">myfile</filename>
  </bhpio><cp run_in_background="false" substitution_string="int_datasets/default.dat int_datasets/${output_filename}.dat"/><bhpread>
    <keys>
      <key>
        <name substitution_string="">ep</name>
        <range substitution_string="">*</range>
      </key><key>
        <name substitution_string="">cdp</name>
        <range substitution_string="">*</range>
      </key>
    </keys><pathlist substitution_string="int_datasets/${input_filename}.dat">myfile.dat</pathlist><filename substitution_string="${input_filename}">myfile</filename>
  </bhpread><bhphorizon><file substitution_string="horizons/${event1_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event2_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event3_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event4_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event5_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event6_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event7_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event8_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event9_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event10_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event11_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhphorizon><file substitution_string="horizons/${event12_name}.xyz">horz.dat</file><shdr>cdp</shdr><phdr>ep</phdr></bhphorizon><bhpwritecube>
    <horizons>
      <horizon substitution_string="${event1_name}"/><horizon substitution_string="${event2_name}"/><horizon substitution_string="${event3_name}"/><horizon substitution_string="${event4_name}"/><horizon substitution_string="${event5_name}"/><horizon substitution_string="${event6_name}"/><horizon substitution_string="${event7_name}"/><horizon substitution_string="${event8_name}"/><horizon substitution_string="${event9_name}"/><horizon substitution_string="${event10_name}"/><horizon substitution_string="${event11_name}"/><horizon substitution_string="${event12_name}"/>
    </horizons><pathlist substitution_string="int_datasets/${output_filename}.dat">fname.dat</pathlist><keys>
      <key>
        <header_word substitution_string="">cdp</header_word>
        <minimum_value substitution_string="${mincdp}">0</minimum_value>
        <increment substitution_string="${inccdp}">1</increment>
        <number_of_bins substitution_string="${ncdp}">1</number_of_bins>
      </key><key>
        <header_word substitution_string="">ep</header_word>
        <minimum_value substitution_string="${minep}">0</minimum_value>
        <increment substitution_string="${incep}">1</increment>
        <number_of_bins substitution_string="${nep}">1</number_of_bins>
      </key>
    </keys><init substitution_string="">yes</init><filename substitution_string="${output_filename}">fname</filename>
  </bhpwritecube><bhpio>
    <pathlist substitution_string="int_datasets/${output_filename}_transpose_cdp.dat">myfile.dat</pathlist><delete substitution_string="">yes</delete><filename substitution_string="${output_filename}_transpose_cdp">myfile</filename>
  </bhpio><bhptranspose>
    <pathlist substitution_string="int_datasets/${output_filename}.dat">fname.dat</pathlist><filename substitution_string="${output_filename}">myfile</filename>
  </bhptranspose><cp run_in_background="false" substitution_string="int_datasets/default.dat int_datasets/${output_filename}_transpose_cdp.dat"/></script>