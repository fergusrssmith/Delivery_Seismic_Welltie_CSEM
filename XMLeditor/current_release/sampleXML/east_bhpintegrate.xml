<?xml version="1.0" encoding="UTF-8"?>
<script>
  
  
  <parameters>
    <parameter>
      <name substitution_string="">project_directory</name>
      <value substitution_string="">/home/ahglim/disk152/brazil</value>
    </parameter><parameter>
      <name>mincdp</name>
      <value>124</value>
    </parameter>
    <parameter>
      <name>inccdp</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>ncdp</name>
      <value>1358</value>
    </parameter>
    <parameter>
      <name>minep</name>
      <value>2200</value>
    </parameter>
    <parameter>
      <name>incep</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>nep</name>
      <value>310</value>
    </parameter>
    <parameter>
      <name>input_filename</name>
      <value>hilb_seismic</value>
    </parameter>
    <parameter>
      <name>output_filename</name>
      <value>east_bhpintegrate</value>
    </parameter>
    <parameter>
      <name>mincdpevent</name>
      <value>1250</value>
    </parameter>
    <parameter>
      <name>maxcdpevent</name>
      <value>1481</value>
    </parameter>
    <parameter>
      <name>minepevent</name>
      <value>2200</value>
    </parameter>
    <parameter>
      <name>maxepevent</name>
      <value>2350</value>
    </parameter>
    <parameter>
      <name>picktop</name>
      <value>east_trough.xyz</value>
    </parameter>
    <parameter>
      <name>pickbottom</name>
      <value>east_peak.xyz</value>
    </parameter>
    <parameter>
      <name>shifttop</name>
      <value>-16</value>
    </parameter>
    <parameter>
      <name>shiftbottom</name>
      <value>16</value>
    </parameter>
    <parameter>
      <name>afile</name>
      <value>bhpintegrate/east</value>
    </parameter>
    <parameter>
      <name>search</name>
      <value>5</value>
    </parameter>
  </parameters><unix_command run_in_background="false" substitution_string="">cd ${project_directory}</unix_command><rm run_in_background="false" substitution_string="">horizons/${afile}.*</rm>
  <bhpread>
    <filename>${input_filename}</filename>
    <pathlist substitution_string="">int_datasets/${input_filename}.dat</pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="">${minepevent}-${maxepevent}</range>
      </key>
      <key>
        <name>cdp</name>
        <range>${mincdpevent}-${maxcdpevent}</range>
      </key>
    </keys>
  </bhpread><bhploadhdr>
    <keys>
      <key>ep</key>
      <key>cdp</key>
      <key>igc</key>
    </keys>
    <infile substitution_string="">horizons/${picktop}</infile>
    <gridtype>R</gridtype>
    <extrap>no</extrap>
    <bias substitution_string="${shifttop}">-16</bias>
  </bhploadhdr>
  <bhploadhdr>
    <keys>
      <key>ep</key>
      <key>cdp</key>
      <key>igi</key>
    </keys>
    <infile substitution_string="">horizons/${pickbottom}</infile>
    <gridtype>R</gridtype>
    <extrap>no</extrap>
    <bias substitution_string="${shiftbottom}">-16</bias>
  </bhploadhdr>
  <sushw>
    <operators>
      <operator>
        <key>delrt</key>
        <a>0</a>
        <b>0</b>
        <c>0</c>
        <d>0</d>
        <j>2147483647</j>
      </operator>
    </operators>
  </sushw>
  <bhpintegrate>
    <mode>edge</mode>
    <type>trough</type>
    
    <search>
      <value substitution_string="${search}">5</value>
    </search><limit>5</limit>
  </bhpintegrate>
  <bhpstorehdr>
    <keys>
      <key>ep</key>
      <key>cdp</key>
      <key>d2</key>
    </keys>
    <ofile substitution_string="">horizons/${afile}.area.xyz</ofile>
  </bhpstorehdr>
  
  <bhpstorehdr>
    <keys>
      <key>ep</key>
      <key>cdp</key>
      <key>f1</key>
    </keys>
    <ofile substitution_string="">horizons/${afile}.width.xyz</ofile>
  </bhpstorehdr><bhpstorehdr>
    <keys>
      <key>ep</key>
      <key>cdp</key>
      <key>f2</key>
    </keys>
    <ofile substitution_string="">horizons/${afile}.amp.xyz</ofile>
  </bhpstorehdr>
  <bhpstorehdr>
    <keys>
      <key>ep</key>
      <key>cdp</key>
      <key>igc</key>
    </keys>
    <ofile substitution_string="">horizons/${afile}.p1.xyz</ofile>
  </bhpstorehdr>
  <bhpstorehdr>
    <keys>
      <key>ep</key>
      <key>cdp</key>
      <key>igi</key>
    </keys>
    <ofile substitution_string="">horizons/${afile}.p2.xyz</ofile>
  </bhpstorehdr>
  <bhpstorehdr>
    <keys>
      <key>ep</key>
      <key>cdp</key>
      <key>corr</key>
    </keys>
    <ofile substitution_string="">horizons/${afile}.p3.xyz</ofile>
  </bhpstorehdr>
  <surange run_in_background="false"/>
  <bhpio>
    
    <delete>yes</delete><filename>${output_filename}</filename>
    <pathlist substitution_string="">int_datasets/${output_filename}.dat</pathlist>
  </bhpio>
  <cp run_in_background="false" substitution_string="">int_datasets/default.dat int_datasets/${output_filename}.dat</cp>
  <bhpread>
    <filename>${input_filename}</filename>
    <pathlist substitution_string="">int_datasets/${input_filename}.dat</pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range>*</range>
      </key>
      <key>
        <name>cdp</name>
        <range>*</range>
      </key>
    </keys>
  </bhpread>
  <bhphorizon>
    <phdr>ep</phdr>
    <shdr>cdp</shdr>
    <file substitution_string="">horizons/${afile}.area.xyz</file>
  </bhphorizon>
  <bhphorizon>
    <phdr>ep</phdr>
    <shdr>cdp</shdr>
    <file substitution_string="">horizons/${afile}.width.xyz</file>
  </bhphorizon>
  <bhphorizon>
    <phdr>ep</phdr>
    <shdr>cdp</shdr>
    <file substitution_string="">horizons/${afile}.amp.xyz</file>
  </bhphorizon>
  <bhphorizon>
    <phdr>ep</phdr>
    <shdr>cdp</shdr>
    <file substitution_string="">horizons/${afile}.p1.xyz</file>
  </bhphorizon>
  <bhphorizon>
    <phdr>ep</phdr>
    <shdr>cdp</shdr>
    <file substitution_string="">horizons/${afile}.p2.xyz</file>
  </bhphorizon>
  <bhphorizon>
    <phdr>ep</phdr>
    <shdr>cdp</shdr>
    <file substitution_string="">horizons/${afile}.p3.xyz</file>
  </bhphorizon>
  <bhpwritecube>
    <init>yes</init>
    <keys>
      <key>
        <header_word>cdp</header_word>
        <minimum_value substitution_string="${mincdp}">124</minimum_value>
        <increment substitution_string="${inccdp}">1</increment>
        <number_of_bins substitution_string="${ncdp}">1358</number_of_bins>
      </key><key>
        <header_word>ep</header_word>
        <minimum_value substitution_string="${minep}">2200</minimum_value>
        <increment substitution_string="${incep}">1</increment>
        <number_of_bins substitution_string="${nep}">310</number_of_bins>
      </key>
      
    </keys>
    <filename>${output_filename}</filename>
    <pathlist substitution_string="">int_datasets/${output_filename}.dat</pathlist>
    <horizons>
      <horizon>area</horizon>
      <horizon>width</horizon>
      <horizon>amp</horizon>
      <horizon>p1</horizon>
      <horizon>p2</horizon>
      <horizon>p3</horizon>
    </horizons>
  </bhpwritecube>
  <bhpio>
    <delete>yes</delete>
    <filename>${output_filename}_transpose_cdp</filename>
    <pathlist substitution_string="">int_datasets/${output_filename}_transpose_cdp.dat</pathlist>
  </bhpio>
  <bhptranspose>
    <filename>${output_filename}</filename>
    <pathlist substitution_string="">int_datasets/${output_filename}.dat</pathlist>
  </bhptranspose>
  <cp run_in_background="false" substitution_string="">int_datasets/default.dat int_datasets/${output_filename}_transpose_cdp.dat</cp>
</script>