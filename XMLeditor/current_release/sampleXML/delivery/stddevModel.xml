<?xml version="1.0" encoding="UTF-8"?>
<script>
  <parameters>
    <parameter>
      <name>input_realisations</name>
      <value>inversion_output_post_north</value>
    </parameter>
    <parameter>
      <name>output_means</name>
      <value>stddev_model_post_north</value>
    </parameter>
    <parameter>
      <name>project_directory</name>
      <value>/home/ahglim/disk152/typhoon</value>
    </parameter>
    <parameter>
      <name>tmp</name>
      <value>tmp4</value>
    </parameter>
    <parameter>
      <name>maxep_invert</name>
      <value>2413</value>
    </parameter>
    <parameter>
      <name>minep_invert</name>
      <value>2329</value>
    </parameter>
    <parameter>
      <name>maxcdp_invert</name>
      <value>4590</value>
    </parameter>
    <parameter>
      <name>mincdp_invert</name>
      <value>4482</value>
    </parameter>
    <parameter>
      <name>mincdp</name>
      <value>3954</value>
    </parameter>
    <parameter>
      <name>inccdp</name>
      <value>4</value>
    </parameter>
    <parameter>
      <name>ncdp</name>
      <value>250</value>
    </parameter>
    <parameter>
      <name>minep</name>
      <value>2025</value>
    </parameter>
    <parameter>
      <name>incep</name>
      <value>4</value>
    </parameter>
    <parameter>
      <name>nep</name>
      <value>102</value>
    </parameter>
    <parameter>
      <name>ep</name>
      <value>2401</value>
    </parameter>
    <parameter>
      <name>cdp</name>
      <value>4554</value>
    </parameter>
  </parameters>
  <unix_command run_in_background="false" substitution_string="cd ${project_directory}"/>
  <bhpread>
    <endian substitution_string="">1</endian>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}">0</range>
      </key>
      <key>
        <name substitution_string="">cdp</name>
        <range substitution_string="${cdp}">0</range>
      </key>
      <key>
        <name substitution_string="">mark</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
    <pathlist substitution_string="int_datasets/${input_realisations}.dat">myfile.dat</pathlist>
    <filename substitution_string="${input_realisations}">myfile</filename>
  </bhpread>
  <deliveryAnalyser>
    <full_stddevs/>
    <BHPcommand>
      <filename substitution_string="${tmp}/bhpwritecube.sh">bhpscript.sh</filename>
    </BHPcommand>
  </deliveryAnalyser>
  <P_file run_in_background="false" substitution_string="${tmp}/means.su">myfile</P_file>
  <cp run_in_background="false" substitution_string="int_datasets/default.dat int_datasets/${output_means}.dat"/>
  <bhpio>
    <pathlist substitution_string="int_datasets/${output_means}.dat">myfile.dat</pathlist>
    <delete substitution_string="">yes</delete>
    <filename substitution_string="${output_means}">myfile</filename>
  </bhpio>
  <unix_command run_in_background="false" substitution_string="bhpwritecube &lt;${tmp}/means.su stdin_endian=1 endian=1 key1=ep,${minep},${incep},${nep} key2=cdp,${mincdp},${inccdp},${ncdp}  pathlist=int_datasets/${output_means}.dat init=yes filename=${output_means} `cat ${tmp}/bhpwritecube.sh`"/>
  <rm run_in_background="false" substitution_string="${tmp}/means.su">tmp/realisations.su</rm>
  <rm run_in_background="false" substitution_string="${tmp}/bhpwritecube.sh"/>
  <bhpread>
    <endian substitution_string="">1</endian>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${minep_invert}-${maxep_invert}[${incep}]">0</range>
      </key>
      <key>
        <name substitution_string="">cdp</name>
        <range substitution_string="${mincdp_invert}-${maxcdp_invert}[${inccdp}]">0</range>
      </key>
      <key>
        <name substitution_string="">mark</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
    <pathlist substitution_string="int_datasets/${input_realisations}.dat">myfile.dat</pathlist>
    <filename substitution_string="${input_realisations}">myfile</filename>
  </bhpread>
  <deliveryAnalyser>
    <full_stddevs/>
  </deliveryAnalyser>
  <bhpwritecube run_in_background="false">
    <rule substitution_string="">replace</rule>
    <stdin_endian substitution_string="">1</stdin_endian>
    <pathlist substitution_string="int_datasets/${output_means}.dat">fname.dat</pathlist>
    <filename substitution_string="${output_means}">fname</filename>
  </bhpwritecube>
  <cp run_in_background="false" substitution_string="int_datasets/default.dat int_datasets/${output_means}_transpose_ep.dat"/>
  <bhpio>
    <pathlist substitution_string="int_datasets/${output_means}_transpose_ep.dat">myfile.dat</pathlist><delete substitution_string="">yes</delete><filename substitution_string="${output_means}_transpose_ep">myfile</filename>
  </bhpio>
  <bhptranspose>
    <pathlist substitution_string="int_datasets/${output_means}.dat">fname.dat</pathlist><filename substitution_string="${output_means}">myfile</filename>
  </bhptranspose>
</script>