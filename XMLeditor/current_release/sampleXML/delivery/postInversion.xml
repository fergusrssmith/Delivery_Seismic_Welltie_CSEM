<?xml version="1.0" encoding="UTF-8"?>
<script>
  <parameters>
    <parameter>
      <name>number_realisations</name>
      <value>50</value>
    </parameter>
    <parameter>
      <name>project_directory</name>
      <value>/home/ahglim/disk152/typhoon</value>
    </parameter>
    <parameter>
      <name>model_description</name>
      <value>Tests/ModelDescription.xml</value>
    </parameter>
    <parameter>
      <name>model_filename</name>
      <value>input_time_model</value>
    </parameter>
    <parameter>
      <name>seismic_filename</name>
      <value>seismic_small</value>
    </parameter>
    <parameter>
      <name>wavelet_filename</name>
      <value>Tests/wavelet.su</value>
    </parameter>
    <parameter>
      <name>output_models_filename</name>
      <value>inversion_output_post</value>
    </parameter>
    <parameter>
      <name>cdp</name>
      <value>4554</value>
    </parameter>
    <parameter>
      <name>ep</name>
      <value>2393</value>
    </parameter>
    <parameter>
      <name>nep</name>
      <value>102</value>
    </parameter>
    <parameter>
      <name>incep</name>
      <value>4</value>
    </parameter>
    <parameter>
      <name>minep</name>
      <value>2025</value>
    </parameter>
    <parameter>
      <name>ncdp</name>
      <value>250</value>
    </parameter>
    <parameter>
      <name>inccdp</name>
      <value>4</value>
    </parameter>
    <parameter>
      <name>mincdp</name>
      <value>3954</value>
    </parameter>
    <parameter>
      <name>mincdp_invert</name>
      <value>4550</value>
    </parameter>
    <parameter>
      <name>maxcdp_invert</name>
      <value>4558</value>
    </parameter>
    <parameter>
      <name>minep_invert</name>
      <value>2329</value>
    </parameter>
    <parameter>
      <name>maxep_invert</name>
      <value>2405</value>
    </parameter>
    <parameter>
      <name>tmp</name>
      <value>tmp1</value>
    </parameter>
  </parameters>
  <unix_command run_in_background="false" substitution_string="cd ${project_directory}"/>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/model_pipe.su"/>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/seismic_pipe.su"/>
  
  
  <bhpread>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}">0</range>
      </key>
      <key>
        <name substitution_string="">cdp</name>
        <range substitution_string="${cdp}">0</range>
      </key>
    </keys>
    <pathlist substitution_string="int_datasets/${seismic_filename}.dat">myfile.dat</pathlist>
    <filename substitution_string="${seismic_filename}">myfile</filename>
  </bhpread><P_file run_in_background="true" substitution_string="${tmp}/seismic_pipe.su">myfile</P_file>
  <bhpread>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}">0</range>
      </key>
      <key>
        <name substitution_string="">cdp</name>
        <range substitution_string="${cdp}">0</range>
      </key>
    </keys>
    <pathlist substitution_string="int_datasets/${model_filename}.dat">myfile.dat</pathlist>
    <filename substitution_string="${model_filename}">myfile</filename>
  </bhpread>
  <P_file run_in_background="true" substitution_string="${tmp}/model_pipe.su">myfile</P_file><delivery>
    <BHPcommand>
      <filename substitution_string="${tmp}/bhpwritecube.sh">bhpscript.sh</filename>
    </BHPcommand>
    <near_stack_wavelet_filename substitution_string="${wavelet_filename}">near-wavelet.su</near_stack_wavelet_filename>
    <PD/>
    <o substitution_string="${tmp}/realisations.su"/>
    <v substitution_string="">4</v>
    <IS/>
    <II/>
    <N substitution_string="">10</N>
    <m substitution_string="${tmp}/model_pipe.su">model_traces.su</m>
    <near_stack_filename substitution_string="${tmp}/seismic_pipe.su">near-stack.su</near_stack_filename>
    <filename substitution_string="${model_description}">ModelDescriptions.xml</filename>
  </delivery>
  <rm run_in_background="false" substitution_string="${tmp}/model_pipe.su"/>
  <rm run_in_background="false" substitution_string="${tmp}/seismic_pipe.su"/>
  <cp run_in_background="false" substitution_string="int_datasets/default.dat int_datasets/${output_models_filename}.dat"/>
  <bhpio>
    <pathlist substitution_string="int_datasets/${output_models_filename}.dat">myfile.dat</pathlist>
    <delete substitution_string="">yes</delete>
    <filename substitution_string="${output_models_filename}">myfile</filename>
  </bhpio>
  <unix_command run_in_background="false" substitution_string="bhpwritecube &lt;${tmp}/realisations.su key1=ep,${minep},${incep},${nep} key2=cdp,${mincdp},${inccdp},${ncdp} key3=mark,1,1,${number_realisations} pathlist=int_datasets/${output_models_filename}.dat init=yes filename=${output_models_filename} `cat ${tmp}/bhpwritecube.sh`"/>
  <rm run_in_background="false" substitution_string="${tmp}/bhpwritecube.sh"/>
  <rm run_in_background="false" substitution_string="${tmp}/realisations.su">tmp/realisations.su</rm>
  <scatter>
    <max_number_threads>10</max_number_threads>
    
  <scatter_parameter>
      <name substitution_string="">cdp</name>
      <range>
        <min substitution_string="${mincdp_invert}">0</min>
        <max substitution_string="${maxcdp_invert}">0</max>
        <increment substitution_string="${inccdp}">1</increment>
        <min_number_per_thread substitution_string="">2</min_number_per_thread>
      </range>
    </scatter_parameter><scatter_parameter>
      <name substitution_string="">ep</name>
      <range>
        <min substitution_string="${minep_invert}">0</min>
        <max substitution_string="${maxep_invert}">0</max>
        <increment substitution_string="${incep}">1</increment>
        <min_number_per_thread substitution_string="">2</min_number_per_thread>
      </range>
    </scatter_parameter></scatter>
  <unix_command run_in_background="false" substitution_string="cd ${project_directory}"/>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/seismic_pipe_${index1}.su"/>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/model_pipe_${index1}.su"/>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/output_models_pipe_${index1}.su"/>
  <bhpread>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}">0</range>
      </key>
      <key>
        <name substitution_string="">cdp</name>
        <range substitution_string="${cdp}">0</range>
      </key>
    </keys>
    <pathlist substitution_string="int_datasets/${model_filename}.dat">myfile.dat</pathlist>
    <filename substitution_string="${model_filename}">myfile</filename>
  </bhpread>
  <P_file run_in_background="true" substitution_string="${tmp}/model_pipe_${index1}.su">myfile</P_file>
  <bhpread>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}">0</range>
      </key>
      <key>
        <name substitution_string="">cdp</name>
        <range substitution_string="${cdp}">0</range>
      </key>
    </keys>
    <pathlist substitution_string="int_datasets/${seismic_filename}.dat">myfile.dat</pathlist>
    <filename substitution_string="${seismic_filename}">myfile</filename>
  </bhpread>
  <P_file run_in_background="true" substitution_string="${tmp}/seismic_pipe_${index1}.su">myfile</P_file>
  <file_P substitution_string="${tmp}/output_models_pipe_${index1}.su"/>
  <bhpwritecube run_in_background="true">
    <rule substitution_string="">replace</rule>
    <pathlist substitution_string="int_datasets/${output_models_filename}.dat">fname.dat</pathlist>
    <filename substitution_string="${output_models_filename}">fname</filename>
  </bhpwritecube>
  <delivery>
    <RWS/>
    <near_stack_wavelet_filename substitution_string="${wavelet_filename}">near-wavelet.su</near_stack_wavelet_filename>
    <PD/>
    <o substitution_string="${tmp}/output_models_pipe_${index1}.su">tmp/realisations.su</o>
    <v substitution_string="">3</v>
    <II/>
    <N substitution_string="${number_realisations}">10</N>
    <m substitution_string="${tmp}/model_pipe_${index1}.su">model_traces.su</m>
    <near_stack_filename substitution_string="${tmp}/seismic_pipe_${index1}.su">near-stack.su</near_stack_filename>
    <filename substitution_string="${model_description}">ModelDescriptions.xml</filename>
  </delivery>
  <rm run_in_background="false" substitution_string="${tmp}/seismic_pipe_${index1}.su"/>
  <rm run_in_background="false" substitution_string="${tmp}/output_models_pipe_${index1}.su"/>
  <rm run_in_background="false" substitution_string="${tmp}/model_pipe_${index1}.su"/>
  <gather/>
</script>