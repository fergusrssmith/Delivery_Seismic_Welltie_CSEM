<?xml version="1.0" encoding="UTF-8"?>
<script>
  <parameters>
    <parameter>
      <name>project_directory</name>
      <value>/home/ahglim/disk152/typhoon</value>
    </parameter>
    <parameter>
      <name>cdp</name>
      <value>4554</value>
    </parameter>
    <parameter>
      <name>property1</name>
      <value>NG</value>
    </parameter>
    <parameter>
      <name>property2</name>
      <value>thickness</value>
    </parameter>
    <parameter>
      <name>layer_number</name>
      <value>7</value>
    </parameter>
    <parameter>
      <name>input_realisations</name>
      <value>inversion_output_post_north</value>
    </parameter>
    <parameter>
      <name>ep</name>
      <value>2401</value>
    </parameter>
  </parameters>
  <unix_command run_in_background="false" substitution_string="cd ${project_directory}"/>
  <bhpread>
    <endian substitution_string="">1</endian>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}">0</range>
      </key>
      <key>
        <name substitution_string="">cdp</name>
        <range substitution_string="${cdp}">0</range>
      </key>
      <key>
        <name substitution_string="">mark</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
    <pathlist substitution_string="int_datasets/${input_realisations}.dat">myfile.dat</pathlist>
    <filename substitution_string="${input_realisations}">myfile</filename>
  </bhpread>
  <deliveryAnalyser>
    <p_ascii2>
      <property1 substitution_string="${property1}">t</property1>
      <property2 substitution_string="${property2}">t</property2>
      <N substitution_string="${layer_number}">1</N>
    </p_ascii2>
  </deliveryAnalyser>
  <P_unix_command run_in_background="false" substitution_string="">graph -TX -S 2 -m 0 -C</P_unix_command>
</script>