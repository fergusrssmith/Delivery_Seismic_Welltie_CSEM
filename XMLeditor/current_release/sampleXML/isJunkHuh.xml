<?xml version="1.0" encoding="UTF-8"?><script>
  <parameters>
    <parameter>
      <name>first_transform</name>
      <value>0</value>
    </parameter>
    <parameter>
      <name>inc_transform</name>
      <value>0.1</value>
    </parameter>
    <parameter>
      <name>last_transform</name>
      <value>1.5</value>
    </parameter>
    <parameter>
      <name>first_stack_low</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>first_stack_high</name>
      <value>5</value>
    </parameter>
    <parameter>
      <name>second_stack_low</name>
      <value>6</value>
    </parameter>
    <parameter>
      <name>second_stack_high</name>
      <value>10</value>
    </parameter>
    <parameter>
      <name>smooth_length</name>
      <value>20</value>
    </parameter>
    <parameter>
      <name>project_path</name>
      <value>/data/D_152_001/ahashb/Brazil</value>
    </parameter>
    <parameter>
      <name>output_filename</name>
      <value>bccammega_wavelet</value>
    </parameter>
    <parameter>
      <name>input_filename</name>
      <value>bcammega_seismic</value>
    </parameter>
    <parameter>
      <name substitution_string="">tmp</name>
      <value substitution_string="">temp</value>
    </parameter>
    <parameter>
      <name>mincdpsigmaslope</name>
      <value>8279</value>
    </parameter>
    <parameter>
      <name>maxcdpsigmaslope</name>
      <value>12049</value>
    </parameter>
    <parameter>
      <name>inccdpsigmaslope</name>
      <value>2</value>
    </parameter>
    <parameter>
      <name>minepsigmaslope</name>
      <value>6258</value>
    </parameter>
    <parameter>
      <name>maxepsigmaslope</name>
      <value>14330</value>
    </parameter>
    <parameter>
      <name>incepsigmaslope</name>
      <value>2</value>
    </parameter>
    <parameter>
      <name>mincdptransform</name>
      <value>8279</value>
    </parameter>
    <parameter>
      <name>maxcdptransform</name>
      <value>12049</value>
    </parameter>
    <parameter>
      <name>inccdptransform</name>
      <value>16</value>
    </parameter>
    <parameter>
      <name>mineptransform</name>
      <value>6258</value>
    </parameter>
    <parameter>
      <name>maxeptransform</name>
      <value>14330</value>
    </parameter>
    <parameter>
      <name>inceptransform</name>
      <value>16</value>
    </parameter>
    <parameter>
      <name>mincdpmean</name>
      <value>8279</value>
    </parameter>
    <parameter>
      <name>maxcdpmean</name>
      <value>12049</value>
    </parameter>
    <parameter>
      <name>inccdpmean</name>
      <value>64</value>
    </parameter>
    <parameter>
      <name>minepmean</name>
      <value>6258</value>
    </parameter>
    <parameter>
      <name>maxepmean</name>
      <value>14330</value>
    </parameter>
    <parameter>
      <name>incepmean</name>
      <value>64</value>
    </parameter>
    <parameter>
      <name>mean_aa1</name>
      <value>DO_NOT_EDIT</value>
    </parameter>
    <parameter>
      <name>mean_aa2</name>
      <value>DO_NOT_EDIT</value>
    </parameter>
    <parameter>
      <name>cdp</name>
      <value>DO_NOT_EDIT</value>
    </parameter>
    <parameter>
      <name>ep</name>
      <value>DO_NOT_EDIT</value>
    </parameter>
    <parameter>
      <name>number_transform</name>
      <value substitution_string="">DO_NOT_EDIT</value>
    </parameter>
  </parameters>
  <unix_command run_in_background="false" substitution_string="number_transform=`echo ${last_transform}/${inc_transform}-${first_transform}/${inc_transform}+1 |bc`"></unix_command>
  <unix_command run_in_background="false" substitution_string="cd ${project_path}"></unix_command>
  <bhpio>
    <delete substitution_string="">yes</delete><pathlist substitution_string="int_datasets/${output_filename}_cwt.dat">myfile.dat</pathlist><filename substitution_string="${output_filename}_cwt">myfile</filename>
  </bhpio>
  <bhpio>
    <delete substitution_string="">yes</delete><pathlist substitution_string="int_datasets/${output_filename}_cwtan.dat">myfile.dat</pathlist><filename substitution_string="${output_filename}_cwtan">myfile</filename>
  </bhpio>
  <cp run_in_background="false" substitution_string="int_datasets/default.dat int_datasets/${output_filename}_cwt.dat"></cp>
  <cp run_in_background="false" substitution_string="int_datasets/default.dat int_datasets/${output_filename}_cwtan.dat"></cp>
  <unix_command_P substitution_string="bhpwavelet time=yes"></unix_command_P>
  <P_file run_in_background="false" substitution_string="${tmp}/wavelet.su">myfile</P_file>
  <bhpread>
    <filename>${input_filename}</filename>
    <pathlist substitution_string="">int_datasets/${input_filename}.dat</pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${minepmean}-${maxepmean}[${incepmean}]"></range>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${mincdpmean}-${maxcdpmean}[${inccdpmean}]"></range>
      </key>
    </keys>
  </bhpread>
  <P_unix_command_P substitution_string="bhpcwt first=${first_transform} inc=${inc_transform} last=${last_transform} wavelet=${tmp}/wavelet.su"></P_unix_command_P>
  
<P_unix_command_P substitution_string="bhpsmooth npass=3 length=${smooth_length} key=cdp nxmax=${number_transform}"></P_unix_command_P>
  <bhpwritecube>
    <init>yes</init>
    <keys>
      <key>
        <header_word>cdp</header_word>
        <minimum_value substitution_string="${mincdptransform}">124</minimum_value>
        <increment substitution_string="${inccdptransform}">1</increment>
        <number_of_bins substitution_string="`echo ${maxcdptransform}/${inccdptransform}-${mincdptransform}/${inccdptransform}+1 |bc`">1358</number_of_bins>
      </key><key>
        <header_word>ep</header_word>
        <minimum_value substitution_string="${mineptransform}">2200</minimum_value>
        <increment substitution_string="${inceptransform}">1</increment>
        <number_of_bins substitution_string="`echo ${maxeptransform}/${inceptransform}-${mineptransform}/${inceptransform}+1 |bc`">310</number_of_bins>
      </key>
      <key>
        <header_word substitution_string="">cdpt</header_word>
        <minimum_value substitution_string="">1</minimum_value>
        <increment>1</increment>
        <number_of_bins substitution_string="${number_transform}">151</number_of_bins>
      </key>
      
    </keys>
    <filename substitution_string="${output_filename}_cwt"></filename>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"></pathlist>
  </bhpwritecube>
  <bhpread>
    <filename substitution_string="${output_filename}_cwt"></filename>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"></pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${minepmean}-${maxepmean}[${incepmean}]"></range>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${mincdpmean}-${maxcdpmean}[${inccdpmean}]"></range>
      </key>
      <key>
        <name substitution_string="">cdpt</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
  </bhpread>
  <suwind>
    <max substitution_string="${first_stack_high}">75</max>
    <min substitution_string="${first_stack_low}">1</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command run_in_background="false" substitution_string="sumean power=1 outpar=${tmp}/mean_aa1.txt"></P_unix_command>
  <bhpread>
    <filename substitution_string="${output_filename}_cwt"></filename>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"></pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${minepmean}-${maxepmean}[${incepmean}]"></range>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${mincdpmean}-${maxcdpmean}[${inccdpmean}]"></range>
      </key>
      <key>
        <name substitution_string="">cdpt</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
  </bhpread>
  <suwind>
    <max substitution_string="${second_stack_high}">151</max>
    <min substitution_string="${second_stack_low}">76</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command run_in_background="false" substitution_string="sumean power=1 outpar=${tmp}/mean_aa2.txt"></P_unix_command>
  <unix_command run_in_background="false" substitution_string="mean_aa1=`cat ${tmp}/mean_aa1.txt | awk &apos;{a = 1. / $3; print a}&apos;`"></unix_command>
  <unix_command run_in_background="false" substitution_string="mean_aa2=`cat ${tmp}/mean_aa2.txt | awk &apos;{a = 1. / $3; print a}&apos;`"></unix_command>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/aa1.su"></unix_command>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/aa2.su"></unix_command>
  <bhpread>
    <filename substitution_string="${output_filename}_cwt"></filename>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"></pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${minepmean}-${maxepmean}[${incepmean}]"></range>
      </key>
      
    <key>
        <name>cdp</name>
        <range substitution_string="${mincdpmean}-${maxcdpmean}[${inccdpmean}]"></range>
      </key>
      <key>
        <name substitution_string="">cdpt</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
  </bhpread>
  <suwind>
    <max substitution_string="${first_stack_high}">75</max>
    <min substitution_string="${first_stack_low}">1</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command_P substitution_string="">sustack key=cdp</P_unix_command_P>
  <sugain>
    <scale substitution_string="${mean_aa1}">1.0</scale>
  </sugain>
  <P_file run_in_background="true" substitution_string="${tmp}/aa1.su">myfile</P_file>
  <bhpread>
    <filename substitution_string="${output_filename}_cwt"></filename>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"></pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${minepmean}-${maxepmean}[${incepmean}]"></range>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${mincdpmean}-${maxcdpmean}[${inccdpmean}]"></range>
      </key>
      <key>
        <name substitution_string="">cdpt</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
  </bhpread>
  <suwind>
    <max substitution_string="${second_stack_high}">151</max>
    <min substitution_string="${second_stack_low}">76</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command_P substitution_string="">sustack key=cdp</P_unix_command_P>
  <sugain>
    <scale substitution_string="${mean_aa1}">1.0</scale>
  </sugain>
  <P_file run_in_background="true" substitution_string="${tmp}/aa2.su">myfile</P_file>
  <unix_command_P substitution_string="sudiff ${tmp}/aa2.su ${tmp}/aa1.su"></unix_command_P>
  <bhpwritecube>
    <init>yes</init>
    <keys>
      <key>
        <header_word>cdp</header_word>
        <minimum_value substitution_string="${mincdpsigmaslope}">124</minimum_value>
        <increment substitution_string="${inccdpsigmaslope}">1</increment>
        <number_of_bins substitution_string="`echo ${maxcdpsigmaslope}/${inccdpsigmaslope}-${mincdpsigmaslope}/${inccdpsigmaslope}+1 |bc`">1358</number_of_bins>
      </key><key>
        <header_word>ep</header_word>
        <minimum_value substitution_string="${minepsigmaslope}">2200</minimum_value>
        <increment substitution_string="${incepsigmaslope}">1</increment>
        <number_of_bins substitution_string="`echo ${maxepsigmaslope}/${incepsigmaslope}-${minepsigmaslope}/${incepsigmaslope}+1 |bc`">310</number_of_bins>
      </key>
      
    </keys>
    <filename substitution_string="${output_filename}_cwtan"></filename>
    <pathlist substitution_string="int_datasets/${output_filename}_cwtan.dat"></pathlist>
  </bhpwritecube>
  <rm run_in_background="false" substitution_string="${tmp}/aa1.su"></rm>
  <rm run_in_background="false" substitution_string="${tmp}/aa2.su"></rm>
  <scatter>
    <max_number_threads substitution_string="">30</max_number_threads>
    
  <scatter_parameter>
      <name substitution_string="">cdp</name>
      <range>
        <min substitution_string="${mincdptransform}">0</min>
        <max substitution_string="${maxcdptransform}">0</max>
        <increment substitution_string="${inccdptransform}">1</increment>
        <min_number_per_thread substitution_string="">2</min_number_per_thread>
      </range>
    </scatter_parameter><scatter_parameter>
      <name substitution_string="">ep</name>
      <range>
        <min substitution_string="${mineptransform}">0</min>
        <max substitution_string="${maxeptransform}">0</max>
        <increment substitution_string="${inceptransform}">1</increment>
        <min_number_per_thread substitution_string="">2</min_number_per_thread>
      </range>
    </scatter_parameter></scatter>
  <unix_command run_in_background="false" substitution_string="number_transform=`echo ${last_transform}/${inc_transform}-${first_transform}/${inc_transform}+1 |bc`"></unix_command>
  <unix_command run_in_background="false" substitution_string="cd ${project_path}"></unix_command>
  <bhpread>
    <filename>${input_filename}</filename>
    <pathlist substitution_string="">int_datasets/${input_filename}.dat</pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}"></range>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${cdp}"></range>
      </key>
    </keys>
  </bhpread>
  <P_unix_command_P substitution_string="bhpcwt first=${first_transform} inc=${inc_transform} last=${last_transform} wavelet=${tmp}/wavelet.su"></P_unix_command_P>
  <P_unix_command_P substitution_string="bhpsmooth npass=3 length=${smooth_length} key=cdp nxmax=${number_transform}"></P_unix_command_P>
  <bhpwritecube>
    <rule substitution_string="">replace</rule>
    <filename substitution_string="${output_filename}_cwt"></filename>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"></pathlist>
  </bhpwritecube>
  <gather></gather>
  <scatter>
    <max_number_threads substitution_string="">30</max_number_threads>
    
  <scatter_parameter>
      <name substitution_string="">cdp</name>
      <range>
        <min substitution_string="${mincdpsigmaslope}">0</min>
        <max substitution_string="${maxcdpsigmaslope}">0</max>
        <increment substitution_string="${inccdpsigmaslope}">1</increment>
        <min_number_per_thread substitution_string="">2</min_number_per_thread>
      </range>
    </scatter_parameter><scatter_parameter>
      <name substitution_string="">ep</name>
      <range>
        <min substitution_string="${minepsigmaslope}">0</min>
        <max substitution_string="${maxepsigmaslope}">0</max>
        <increment substitution_string="${incepsigmaslope}">1</increment>
        <min_number_per_thread substitution_string="">2</min_number_per_thread>
      </range>
    </scatter_parameter></scatter>
  <unix_command run_in_background="false" substitution_string="number_transform=`echo ${last_transform}/${inc_transform}-${first_transform}/${inc_transform}+1 |bc`"></unix_command>
  <unix_command run_in_background="false" substitution_string="cd ${project_path}"></unix_command>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/aa1_${index1}.su"></unix_command>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/aa2_${index1}.su"></unix_command>
  <unix_command run_in_background="false" substitution_string="mean_aa1=`cat ${tmp}/mean_aa1.txt | awk &apos;{a = 1. / $3; print a}&apos;`"></unix_command>
  <unix_command run_in_background="false" substitution_string="mean_aa2=`cat ${tmp}/mean_aa2.txt | awk &apos;{a = 1. / $3; print a}&apos;`"></unix_command>
  <bhpread>
    <filename>${input_filename}</filename>
    <pathlist substitution_string="">int_datasets/${input_filename}.dat</pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}"></range>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${cdp}"></range>
      </key>
    </keys>
  </bhpread>
  <P_unix_command_P substitution_string="bhpcwt first=${first_transform} inc=${inc_transform} last=${last_transform} wavelet=${tmp}/wavelet.su"></P_unix_command_P>
  <P_unix_command_P substitution_string="bhpsmooth npass=3 length=${smooth_length} key=cdp nxmax=${number_transform}"></P_unix_command_P>
  <suwind>
    <max substitution_string="${first_stack_high}">75</max>
    <min substitution_string="${first_stack_low}">1</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command_P substitution_string="">sustack key=cdp</P_unix_command_P>
  <sugain>
    <scale substitution_string="${mean_aa1}">1.0</scale>
  </sugain>
  <P_file run_in_background="true" substitution_string="${tmp}/aa1_${index1}.su">myfile</P_file>
  <bhpread>
    <filename>${input_filename}</filename>
    <pathlist substitution_string="">int_datasets/${input_filename}.dat</pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}"></range>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${cdp}"></range>
      </key>
    </keys>
  </bhpread>
  <P_unix_command_P substitution_string="bhpcwt first=${first_transform} inc=${inc_transform} last=${last_transform} wavelet=${tmp}/wavelet.su"></P_unix_command_P>
  <P_unix_command_P substitution_string="bhpsmooth npass=3 length=${smooth_length} key=cdp nxmax=${number_transform}"></P_unix_command_P>
  <suwind>
    <max substitution_string="${second_stack_high}">151</max>
    <min substitution_string="${second_stack_low}">76</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command_P substitution_string="">sustack key=cdp</P_unix_command_P>
  <sugain>
    <scale substitution_string="${mean_aa1}">1.0</scale>
  </sugain>
  <P_file run_in_background="true" substitution_string="${tmp}/aa2_${index1}.su">myfile</P_file>
  <unix_command_P substitution_string="sudiff ${tmp}/aa2_${index1}.su ${tmp}/aa1_${index1}.su"></unix_command_P>
  <bhpwritecube>
    <rule substitution_string="">replace</rule>
    <filename substitution_string="${output_filename}_cwtan"></filename>
    <pathlist substitution_string="int_datasets/${output_filename}_cwtan.dat"></pathlist>
  </bhpwritecube>
  <rm run_in_background="false" substitution_string="${tmp}/aa1_${index1}.su"></rm>
  <rm run_in_background="false" substitution_string="${tmp}/aa2_${index1}.su"></rm>
  <gather></gather>
  <unix_command run_in_background="false" substitution_string="cd ${project_path}"></unix_command>
  <rm run_in_background="false" substitution_string="${tmp}/wavelet.su"></rm>
  <unix_command run_in_background="false" substitution_string="cat ${tmp}/mean_aa1.txt"></unix_command>
  <unix_command run_in_background="false" substitution_string="cat ${tmp}/mean_aa2.txt"></unix_command>
  <rm run_in_background="false" substitution_string="${tmp}/mean_aa1.txt"></rm>
  <rm run_in_background="false" substitution_string="${tmp}/mean_aa2.txt"></rm>
 </script>