<?xml version="1.0" encoding="UTF-8"?>
<script>
  <parameters>
    <parameter>
      <name>first_transform</name>
      <value>0</value>
    </parameter>
    <parameter>
      <name>inc_transform</name>
      <value>0.01</value>
    </parameter>
    <parameter>
      <name>last_transform</name>
      <value>1.5</value>
    </parameter>
    <parameter>
      <name>first_stack_low</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>first_stack_high</name>
      <value>50</value>
    </parameter>
    <parameter>
      <name>second_stack_low</name>
      <value>50</value>
    </parameter>
    <parameter>
      <name>second_stack_high</name>
      <value>100</value>
    </parameter>
    <parameter>
      <name>smooth_length</name>
      <value>20</value>
    </parameter>
    <parameter>
      <name>mincdp</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>inccdp</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>ncdp</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>minep</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>incep</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>nep</name>
      <value>4707</value>
    </parameter>
    <parameter>
      <name>project_path</name>
      <value>/home/ahglim/disk152/cascade</value>
    </parameter>
    <parameter>
      <name>output_filename</name>
      <value>wavelet</value>
    </parameter>
    <parameter>
      <name>input_filename</name>
      <value>seismic</value>
    </parameter>
    <parameter>
      <name substitution_string="">tmp</name>
      <value substitution_string="">tmp</value>
    </parameter>
    <parameter>
      <name>mincdptransform</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>maxcdptransform</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>mineptransform</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>maxeptransform</name>
      <value>4707</value>
    </parameter>
    <parameter>
      <name>mincdpmean</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>maxcdpmean</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>inccdpmean</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>minepmean</name>
      <value>1</value>
    </parameter>
    <parameter>
      <name>maxepmean</name>
      <value>4707</value>
    </parameter>
    <parameter>
      <name>incepmean</name>
      <value>20</value>
    </parameter>
    <parameter>
      <name>mean_aa1</name>
      <value>DO_NOT_EDIT</value>
    </parameter>
    <parameter>
      <name>mean_aa2</name>
      <value>DO_NOT_EDIT</value>
    </parameter>
    <parameter>
      <name>cdp</name>
      <value>DO_NOT_EDIT</value>
    </parameter>
    <parameter>
      <name>ep</name>
      <value>DO_NOT_EDIT</value>
    </parameter>
    <parameter>
      <name>number_transform</name>
      <value substitution_string="">DO_NOT_EDIT</value>
    </parameter>
  </parameters>
  <unix_command run_in_background="false" substitution_string="number_transform=`echo ${last_transform}/${inc_transform}-${first_transform}/${inc_transform}+1 |bc`"/>
  <unix_command run_in_background="false" substitution_string="cd ${project_path}"/>
  <bhpio>
    <delete substitution_string="">yes</delete><pathlist substitution_string="int_datasets/${output_filename}_cwt.dat">myfile.dat</pathlist><filename substitution_string="${output_filename}_cwt">myfile</filename>
  </bhpio>
  <bhpio>
    <delete substitution_string="">yes</delete><pathlist substitution_string="int_datasets/${output_filename}_cwtan.dat">myfile.dat</pathlist><filename substitution_string="${output_filename}_cwtan">myfile</filename>
  </bhpio>
  <cp run_in_background="false" substitution_string="int_datasets/default.dat int_datasets/${output_filename}_cwt.dat"/>
  <cp run_in_background="false" substitution_string="int_datasets/default.dat int_datasets/${output_filename}_cwtan.dat"/>
  <unix_command_P substitution_string="bhpwavelet time=yes"/>
  <P_file run_in_background="false" substitution_string="${tmp}/wavelet.su">myfile</P_file>
  <bhpread>
    <filename>${input_filename}</filename>
    <pathlist substitution_string="">int_datasets/${input_filename}.dat</pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${minepmean}-${maxepmean}[${incepmean}]"/>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${mincdpmean}-${maxcdpmean}[${inccdpmean}]"/>
      </key>
    </keys>
  </bhpread>
  <P_unix_command_P substitution_string="bhpcwt first=${first_transform} inc=${inc_transform} last=${last_transform} wavelet=${tmp}/wavelet.su"/>
  
<P_unix_command_P substitution_string="bhpsmooth npass=3 length=${smooth_length} key=ep nxmax=${number_transform}"/>
  <bhpwritecube>
    <init>yes</init>
    <keys>
      <key>
        <header_word>cdp</header_word>
        <minimum_value substitution_string="${mincdp}">124</minimum_value>
        <increment substitution_string="${inccdpmean}">1</increment>
        <number_of_bins substitution_string="`echo ${ncdp}*${inccdp}/${inccdpmean}+1 |bc`">1358</number_of_bins>
      </key><key>
        <header_word>ep</header_word>
        <minimum_value substitution_string="${minep}">2200</minimum_value>
        <increment substitution_string="${incepmean}">1</increment>
        <number_of_bins substitution_string="`echo ${nep}*${incep}/${incepmean}+1 |bc`">310</number_of_bins>
      </key>
      <key>
        <header_word substitution_string="">cdpt</header_word>
        <minimum_value substitution_string="">1</minimum_value>
        <increment>1</increment>
        <number_of_bins substitution_string="${number_transform}">151</number_of_bins>
      </key>
      
    </keys>
    <filename substitution_string="${output_filename}_cwt"/>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"/>
  </bhpwritecube>
  <bhpread>
    <filename substitution_string="${output_filename}_cwt"/>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"/>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${minepmean}-${maxepmean}[${incepmean}]"/>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${mincdpmean}-${maxcdpmean}[${inccdpmean}]"/>
      </key>
      <key>
        <name substitution_string="">cdpt</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
  </bhpread>
  <suwind>
    <max substitution_string="${first_stack_high}">75</max>
    <min substitution_string="${first_stack_low}">1</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command run_in_background="false" substitution_string="sumean power=1 outpar=${tmp}/mean_aa1.txt"/>
  <bhpread>
    <filename substitution_string="${output_filename}_cwt"/>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"/>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${minepmean}-${maxepmean}[${incepmean}]"/>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${mincdpmean}-${maxcdpmean}[${inccdpmean}]"/>
      </key>
      <key>
        <name substitution_string="">cdpt</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
  </bhpread>
  <suwind>
    <max substitution_string="${second_stack_high}">151</max>
    <min substitution_string="${second_stack_low}">76</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command run_in_background="false" substitution_string="sumean power=1 outpar=${tmp}/mean_aa2.txt"/>
  <unix_command run_in_background="false" substitution_string="mean_aa1=`cat ${tmp}/mean_aa1.txt | awk '{a = 1. / $3; print a}'`"/>
  <unix_command run_in_background="false" substitution_string="mean_aa2=`cat ${tmp}/mean_aa2.txt | awk '{a = 1. / $3; print a}'`"/>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/aa1.su"/>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/aa2.su"/>
  <bhpread>
    <filename substitution_string="${output_filename}_cwt"/>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"/>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${mineptransform}-${maxeptransform}"/>
      </key>
      
    <key>
        <name>cdp</name>
        <range substitution_string="${mincdptransform}-${maxcdptransform}"/>
      </key>
      <key>
        <name substitution_string="">cdpt</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
  </bhpread>
  <suwind>
    <max substitution_string="${first_stack_high}">75</max>
    <min substitution_string="${first_stack_low}">1</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command_P substitution_string="">sustack key=ep</P_unix_command_P>
  <sugain>
    <scale substitution_string="${mean_aa1}">1.0</scale>
  </sugain>
  <P_file run_in_background="true" substitution_string="${tmp}/aa1.su">myfile</P_file>
  <bhpread>
    <filename substitution_string="${output_filename}_cwt"/>
    <pathlist substitution_string="int_datasets/${output_filename}_cwt.dat"/>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${mineptransform}-${maxeptransform}"/>
      </key>
      
    <key>
        <name>cdp</name>
        <range substitution_string="${mincdptransform}-${maxcdptransform}"/>
      </key>
      <key>
        <name substitution_string="">cdpt</name>
        <range substitution_string="">*</range>
      </key>
    </keys>
  </bhpread>
  <suwind>
    <max substitution_string="${second_stack_high}">151</max>
    <min substitution_string="${second_stack_low}">76</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command_P substitution_string="">sustack key=ep</P_unix_command_P>
  <sugain>
    <scale substitution_string="${mean_aa1}">1.0</scale>
  </sugain>
  <P_file run_in_background="true" substitution_string="${tmp}/aa2.su">myfile</P_file>
  <unix_command_P substitution_string="sudiff ${tmp}/aa2.su ${tmp}/aa1.su"/>
  <bhpwritecube>
    <init>yes</init>
    <keys>
      <key>
        <header_word>cdp</header_word>
        <minimum_value substitution_string="${mincdp}">124</minimum_value>
        <increment substitution_string="${inccdp}">1</increment>
        <number_of_bins substitution_string="${ncdp}">1358</number_of_bins>
      </key><key>
        <header_word>ep</header_word>
        <minimum_value substitution_string="${minep}">2200</minimum_value>
        <increment substitution_string="${incep}">1</increment>
        <number_of_bins substitution_string="${nep}">310</number_of_bins>
      </key>
      
    </keys>
    <filename substitution_string="${output_filename}_cwtan"/>
    <pathlist substitution_string="int_datasets/${output_filename}_cwtan.dat"/>
  </bhpwritecube>
  <rm run_in_background="false" substitution_string="${tmp}/aa1.su"/>
  <rm run_in_background="false" substitution_string="${tmp}/aa2.su"/>
  <scatter>
    <max_number_threads substitution_string="">30</max_number_threads>
    
  <scatter_parameter>
      <name substitution_string="">cdp</name>
      <range>
        <min substitution_string="${mincdptransform}">0</min>
        <max substitution_string="${maxcdptransform}">0</max>
        <increment substitution_string="${inccdp}">1</increment>
        <min_number_per_thread substitution_string="">2</min_number_per_thread>
      </range>
    </scatter_parameter><scatter_parameter>
      <name substitution_string="">ep</name>
      <range>
        <min substitution_string="${mineptransform}">0</min>
        <max substitution_string="${maxeptransform}">0</max>
        <increment substitution_string="${incep}">1</increment>
        <min_number_per_thread substitution_string="">2</min_number_per_thread>
      </range>
    </scatter_parameter></scatter>
  <unix_command run_in_background="false" substitution_string="number_transform=`echo ${last_transform}/${inc_transform}-${first_transform}/${inc_transform}+1 |bc`"/>
  <unix_command run_in_background="false" substitution_string="cd ${project_path}"/>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/aa1_${index1}.su"/>
  <unix_command run_in_background="false" substitution_string="mkfifo ${tmp}/aa2_${index1}.su"/>
  <unix_command run_in_background="false" substitution_string="mean_aa1=`cat ${tmp}/mean_aa1.txt | awk '{a = 1. / $3; print a}'`"/>
  <unix_command run_in_background="false" substitution_string="mean_aa2=`cat ${tmp}/mean_aa2.txt | awk '{a = 1. / $3; print a}'`"/>
  <bhpread>
    <filename>${input_filename}</filename>
    <pathlist substitution_string="">int_datasets/${input_filename}.dat</pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}"/>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${cdp}"/>
      </key>
    </keys>
  </bhpread>
  <P_unix_command_P substitution_string="bhpcwt first=${first_transform} inc=${inc_transform} last=${last_transform} wavelet=${tmp}/wavelet.su"/>
  <P_unix_command_P substitution_string="bhpsmooth npass=3 length=${smooth_length} key=ep nxmax=${number_transform}"/>
  <suwind>
    <max substitution_string="${first_stack_high}">75</max>
    <min substitution_string="${first_stack_low}">1</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command_P substitution_string="">sustack key=ep</P_unix_command_P>
  <sugain>
    <scale substitution_string="${mean_aa1}">1.0</scale>
  </sugain>
  <P_file run_in_background="true" substitution_string="${tmp}/aa1_${index1}.su">myfile</P_file>
  <bhpread>
    <filename>${input_filename}</filename>
    <pathlist substitution_string="">int_datasets/${input_filename}.dat</pathlist>
    <keys>
      <key>
        <name>ep</name>
        <range substitution_string="${ep}"/>
      </key>
      <key>
        <name>cdp</name>
        <range substitution_string="${cdp}"/>
      </key>
    </keys>
  </bhpread>
  <P_unix_command_P substitution_string="bhpcwt first=${first_transform} inc=${inc_transform} last=${last_transform} wavelet=${tmp}/wavelet.su"/>
  <P_unix_command_P substitution_string="bhpsmooth npass=3 length=${smooth_length} key=ep nxmax=${number_transform}"/>
  <suwind>
    <max substitution_string="${second_stack_high}">151</max>
    <min substitution_string="${second_stack_low}">76</min>
    <key substitution_string="">cdpt</key>
  </suwind>
  <P_unix_command_P substitution_string="">sustack key=ep</P_unix_command_P>
  <sugain>
    <scale substitution_string="${mean_aa1}">1.0</scale>
  </sugain>
  <P_file run_in_background="true" substitution_string="${tmp}/aa2_${index1}.su">myfile</P_file>
  <unix_command_P substitution_string="sudiff ${tmp}/aa2_${index1}.su ${tmp}/aa1_${index1}.su"/>
  <bhpwritecube>
    <rule substitution_string="">replace</rule>
    <keys>
      <key>
        <header_word>cdp</header_word>
        <minimum_value substitution_string="${mincdp}">124</minimum_value>
        <increment substitution_string="${inccdp}">1</increment>
        <number_of_bins substitution_string="${ncdp}">1358</number_of_bins>
      </key><key>
        <header_word>ep</header_word>
        <minimum_value substitution_string="${minep}">2200</minimum_value>
        <increment substitution_string="${incep}">1</increment>
        <number_of_bins substitution_string="${nep}">310</number_of_bins>
      </key>
      
    </keys>
    <filename substitution_string="${output_filename}_cwtan"/>
    <pathlist substitution_string="int_datasets/${output_filename}_cwtan.dat"/>
  </bhpwritecube>
  <rm run_in_background="false" substitution_string="${tmp}/aa1_${index1}.su"/>
  <rm run_in_background="false" substitution_string="${tmp}/aa2_${index1}.su"/>
  <gather/>
  <rm run_in_background="false" substitution_string="${tmp}/wavelet.su"/>
  <unix_command run_in_background="false" substitution_string="cat ${tmp}/mean_aa1.txt"/>
  <unix_command run_in_background="false" substitution_string="cat ${tmp}/mean_aa2.txt"/>
  <rm run_in_background="false" substitution_string="${tmp}/mean_aa1.txt"/>
  <rm run_in_background="false" substitution_string="${tmp}/mean_aa2.txt"/>
 </script>