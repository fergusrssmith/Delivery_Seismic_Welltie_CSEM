<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <xsd:complexType name="intManyAtts">
    <xsd:simpleContent>
      <xsd:extension base="xsd:integer">      
        <xsd:attribute name="alice" type="xsd:integer" default="123"/>
	<xsd:attribute name="bob" type="xsd:string" default="chickens"/>
	<xsd:attribute name="charles" default="none">
	  <xsd:simpleType>
	    <xsd:restriction base="xsd:string">
              <xsd:enumeration value="full"/>
              <xsd:enumeration value="partial"/>
              <xsd:enumeration value="none"/>
            </xsd:restriction>
          </xsd:simpleType>
	</xsd:attribute>
	<xsd:attribute name="dave" type="xsd:float" default="0.456"/>
	<xsd:attribute name="edgar" type="xsd:anyURI" default="filename.txt"/>
        <xsd:attribute name="frank" type="xsd:boolean" default="true"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

</xsd:schema>
      