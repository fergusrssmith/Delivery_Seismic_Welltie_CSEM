<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  
  <xsd:include schemaLocation="bhpcommon.xsd"/>

  <xsd:complexType name="deliveryAnalyserType">
    <xsd:all>
      <xsd:element name="BHPcommand" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="filename" type="subbable_anyURI" default="bhpscript.sh"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="Raftery" minOccurs="0">
	<xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="property" type="subbable_string" default="fluid_type"/>
	    <xsd:element name="layer_no" type="subbable_string" default="1"/>
          </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="filter" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="property" type="subbable_string" default="fluid_type"/>
	    <xsd:element name="comparator" default="=">
	      <xsd:complexType>
	        <xsd:simpleContent>
		  <xsd:restriction base="subbable_string">
		    <xsd:enumeration value="&lt;"/>
		    <xsd:enumeration value="&gt;"/>
		    <xsd:enumeration value="="/>
		  </xsd:restriction>
		</xsd:simpleContent>
	      </xsd:complexType>
	    </xsd:element>
	    <xsd:element name="comparison_value" type="subbable_float" default="0"/>
	    <xsd:element name="layer_no" type="subbable_integer" default="1"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="full" minOccurs="0" type="emptyType"/>
      <xsd:element name="full_means" minOccurs="0" type="emptyType"/>
      <xsd:element name="full_quantile" minOccurs="0" type="subbable_float" default="50"/>
      <xsd:element name="full_stddevs" minOccurs="0" type="emptyType"/>
      <xsd:element name="histogram" minOccurs="0">
	<xsd:complexType> 
	  <xsd:sequence>
	    <xsd:element name="property" type="subbable_string" default="t"/>
	    <xsd:element name="N" type="subbable_integer" default="1"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="layer" minOccurs="0">
	<xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="t_start_in_seconds" type="subbable_float" default="1.0"/>
	    <xsd:element name="t_end_in_seconds" type="subbable_float" default="1.0"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="layer_colors" minOccurs="0" type="subbable_string" default="1,2,1,3"/>
      <xsd:element name="layers_add_ensemble_boundaries" minOccurs="0" type="emptyType"/>
      <xsd:element name="mean" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="property" type="subbable_string" default="t"/>
	    <xsd:element name="N" type="subbable_integer" default="1"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="quantile" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="property" type="subbable_string" default="t"/>
	    <xsd:element name="N" type="subbable_integer" default="1"/>
	    <xsd:element name="Q" type="subbable_float" default="50"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="realisation_header_word" minOccurs="0" type="headerWord" default="mark"/>
      <xsd:element name="stddev" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="property" type="subbable_string" default="t"/>
	    <xsd:element name="N" type="subbable_integer" default="1"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="time_to_depth" minOccurs="0" type="emptyType"/>
      <xsd:element name="trace_filter" minOccurs="0" type="subbable_string" default="fldr&gt;100,ep=234"/>
      <xsd:element name="f" minOccurs="0" type="emptyType"/>
      <xsd:element name="i" minOccurs="0" type="subbable_anyURI" default="realisations.su"/>
      <xsd:element name="l" minOccurs="0" type="emptyType"/>
      <xsd:element name="p" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="property" type="subbable_string" default="t"/>
	    <xsd:element name="N" type="subbable_integer" default="1"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="p_ascii" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="property" type="subbable_string" default="t"/>
	    <xsd:element name="N" type="subbable_integer" default="1"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="p_ascii_full" minOccurs="0" type="emptyType"/>
      <xsd:element name="p_ascii2" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="property1" type="subbable_string" default="t"/>
	    <xsd:element name="property2" type="subbable_string" default="t"/>
	    <xsd:element name="N" type="subbable_integer" default="1"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="s" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="t_start_in_seconds" type="subbable_float" default="0"/>
	    <xsd:element name="t_end_in_seconds" type="subbable_float" default="1"/>
	    <xsd:element name="reflection_coefficient" default="R_near">
	      <xsd:complexType>
	        <xsd:simpleContent>
	          <xsd:restriction base="subbable_string">
		    <xsd:enumeration value="R_near"/>
		    <xsd:enumeration value="R_far"/>
		  </xsd:restriction>
		</xsd:simpleContent>
	      </xsd:complexType>
	    </xsd:element>
	    <xsd:element name="wavelet_filename" type="subbable_anyURI" default="wavelet_filename.su"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="v" minOccurs="0" type="subbable_integer" default="4"/>
      <xsd:element name="wait" minOccurs="0" type="emptyType"/>
    </xsd:all>
  </xsd:complexType>
</xsd:schema>
