<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <xsd:include schemaLocation="bhpcommon.xsd"/>

  <xsd:complexType name="bhpwritecubeType">
    <xsd:all>
      <xsd:element name="filename" type="subbable_string" default="fname"/>
      <xsd:element name="init" type="yes_no_Type" minOccurs="0" default="no"/>
      <xsd:element name="pathlist" type="subbable_anyURI" minOccurs="0" default="fname.dat"/>
      <xsd:element name="keys" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="key" maxOccurs="5">
	      <xsd:complexType>
	        <xsd:sequence>
		  <xsd:element name="header_word" type="headerWord" default="fldr"/>
		  <xsd:element name="minimum_value" type="subbable_integer" default="0"/>
		  <xsd:element name="increment" type="subbable_integer" default="1"/>
		  <xsd:element name="number_of_bins" type="subbable_integer" default="1"/>
		</xsd:sequence>
	      </xsd:complexType>
	    </xsd:element>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="bin" type="subbable_integer" minOccurs="0" default="1"/>
      <xsd:element name="action" minOccurs="0" default="w">
        <xsd:complexType>
	  <xsd:simpleContent>
	    <xsd:restriction base="xsd:string">
	      <xsd:enumeration value="w"/>
	      <xsd:enumeration value="i"/>
	      <xsd:enumeration value="a"/>
	    </xsd:restriction>
	  </xsd:simpleContent>
	  <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="rule" minOccurs="0" default="keep">
        <xsd:complexType>
	  <xsd:simpleContent>
	    <xsd:restriction base="xsd:string">
	      <xsd:enumeration value="keep"/>
	      <xsd:enumeration value="replace"/>
	      <xsd:enumeration value="stack"/>
	      <xsd:enumeration value="min"/>
	      <xsd:enumeration value="max"/>
	    </xsd:restriction>
	  </xsd:simpleContent>
	  <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="binhdr" type="headerWord" minOccurs="0" default="offset"/>
      <xsd:element name="maxens" type="subbable_integer" minOccurs="0" default="0"/>
      <xsd:element name="prealloc" type="yes_no_Type" minOccurs="0" default="no"/>
      <xsd:element name="stripe" type="yes_no_Type" minOccurs="0" default="yes"/>
      <xsd:element name="size" type="subbable_integer" minOccurs="0" default="1999"/>
      <xsd:element name="properties" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="property" type="subbable_string" maxOccurs="unbounded"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="horizons" minOccurs="0">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="horizon" type="subbable_string" maxOccurs="unbounded"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="endian" type="bitBoolType" minOccurs="0" default="0"/>
      <xsd:element name="stdin_endian" minOccurs="0" default="2">
        <xsd:complexType>
	  <xsd:simpleContent>
	    <xsd:restriction base="xsd:integer">
	      <xsd:enumeration value="0"/>
	      <xsd:enumeration value="1"/>
	      <xsd:enumeration value="2"/>
	    </xsd:restriction>
	  </xsd:simpleContent>
	  <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="transpose" type="yes_no_Type" minOccurs="0" default="no"/>
      <xsd:element name="vkey" type="headerWord" minOccurs="0" default="tracl"/>
      <xsd:element name="units" minOccurs="0" default="0">
        <xsd:complexType>
	  <xsd:simpleContent>
	    <xsd:restriction base="xsd:integer">
	      <xsd:enumeration value="0"/>
	      <xsd:enumeration value="1"/>
	      <xsd:enumeration value="2"/>
	    </xsd:restriction>
	  </xsd:simpleContent>
	  <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="verbose" type="bitBoolType" minOccurs="0" default="0"/>
    </xsd:all>
    <xsd:attribute name="run_in_background" type="xsd:boolean" default="false"/>
  </xsd:complexType>
</xsd:schema>
