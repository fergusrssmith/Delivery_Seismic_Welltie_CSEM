<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  
  <xsd:include schemaLocation="bhpcommon.xsd"/>

  <xsd:complexType name="bhploadhdrType">
    <xsd:all>
      <xsd:element name="keys">
	<xsd:complexType>
	  <xsd:sequence>
	    <!-- what type is key? -->
	    <xsd:element name="key" type="subbable_string" minOccurs="3" maxOccurs="4" default="keyvalue"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="infile" type="subbable_anyURI" default="myASCIIfile"/>
      <xsd:element name="bias" type="subbable_float" minOccurs="0" default="0"/>
      <xsd:element name="scalar" type="subbable_float" minOccurs="0" default="1"/>
      <xsd:element name="null" type="subbable_float" minOccurs="0" default="-999.25"/>
      <xsd:element name="gridtype" minOccurs="0" type="R_I_Type" default="R"/>
      <xsd:element name="extrap" minOccurs="0" type="yes_no_Type" default="no"/>
      <xsd:element name="verbose" minOccurs="0" type="bitBoolType" default="0"/>
    </xsd:all>
  </xsd:complexType>
</xsd:schema>