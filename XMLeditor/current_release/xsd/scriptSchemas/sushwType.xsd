<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <xsd:include schemaLocation="bhpcommon.xsd"/>

  <xsd:complexType name="sushwType">
    <xsd:all>
      <xsd:element name="operators">
        <xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="operator" maxOccurs="unbounded">
	      <xsd:complexType>
	        <xsd:sequence>
		  <xsd:element name="key" type="headerWord" default="cdp"/>
		  <xsd:element name="a" type="subbable_integer" default="0"/>
		  <xsd:element name="b" type="subbable_integer" default="0"/>
		  <xsd:element name="c" type="subbable_integer" default="0"/>
		  <xsd:element name="d" type="subbable_integer" default="0"/>
		  <!-- what to do about j? -->
		  <xsd:element name="j" type="subbable_integer" default="2147483647"/>
		</xsd:sequence>
	      </xsd:complexType>
	    </xsd:element>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
    </xsd:all>
  </xsd:complexType>
</xsd:schema>