<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  
 <xsd:include schemaLocation="bhpcommon.xsd"/>
  
 <xsd:complexType name="machineType">
   <xsd:simpleContent>
     <xsd:restriction base="xsd:integer">
       <xsd:enumeration value="0"/>
       <xsd:enumeration value="10"/>
       <xsd:enumeration value="11"/>
       <xsd:enumeration value="20"/>
       <xsd:enumeration value="30"/>
       <xsd:enumeration value="40"/>
     </xsd:restriction>
   </xsd:simpleContent>
   <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
 </xsd:complexType>
 
 <xsd:complexType name="sucleanType">
   <xsd:all>
     <xsd:element name="verbose" type="bitBoolType" minOccurs="0" default="0"/>
     <!-- default nsegy??? -->
     <xsd:element name="nsegy" type="subbable_integer" minOccurs="0" default="0"/>
     <xsd:element name="imach" type="machineType" minOccurs="0" default="0"/>
     <xsd:element name="omach" type="machineType" minOccurs="0" default="0"/>
   </xsd:all>
 </xsd:complexType>
</xsd:schema>