<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <xsd:include schemaLocation="bhpcommon.xsd"/>

  <xsd:complexType name="bhpstorehdrType">
    <xsd:all>
      <xsd:element name="keys" minOccurs="0">
	<xsd:complexType>
	  <xsd:sequence>
	    <!-- key: what type, what default? -->
	    <xsd:element name="key" type="headerWord" maxOccurs="3" default="d2"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>
      <!-- path issue -->
      <xsd:element name="ofile" type="subbable_anyURI" minOccurs="0" deafult="area.dat"/>
      <xsd:element name="bias" type="subbable_float" minOccurs="0" default="0"/>
      <xsd:element name="scalar" type="subbable_float" minOccurs="0" default="1"/>
      <xsd:element name="compress" minOccurs="0" type="yes_no_Type" default="no"/>
    </xsd:all>
  </xsd:complexType>
</xsd:schema>