<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  
  <xsd:include schemaLocation="bhpcommon.xsd"/>

  <xsd:complexType name="bhpintegrateType">
    <xsd:all>
      <xsd:element name="mode" minOccurs="0" default="point">
	<xsd:complexType>
	  <xsd:simpleContent>
	    <xsd:restriction base="subbable_string">
	      <xsd:enumeration value="point"/>
	      <xsd:enumeration value="edge"/>
	    </xsd:restriction>
	  </xsd:simpleContent>
	  <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="Z" minOccurs="0" type="headerWord" default="sut"/>
      <xsd:element name="A" minOccurs="0" type="headerWord" default="d2"/>
      <xsd:element name="L" minOccurs="0" type="headerWord" default="f1"/>
      <xsd:element name="H" minOccurs="0" type="headerWord" default="f2"/>
      <xsd:element name="P1" minOccurs="0" type="headerWord" default="igc"/>
      <xsd:element name="P2" minOccurs="0" type="headerWord" default="igi"/>
      <xsd:element name="P3" minOccurs="0" type="headerWord" default="corr"/>
      <xsd:element name="type" minOccurs="0" default="peak">
        <xsd:complexType>
	  <xsd:simpleContent>
	    <xsd:restriction base="subbable_string">
	      <xsd:enumeration value="peak"/>
	      <xsd:enumeration value="trough"/>
	    </xsd:restriction>
	  </xsd:simpleContent>
	  <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
	</xsd:complexType>
      </xsd:element>
      <xsd:element name="search" minOccurs="0">
	<xsd:complexType>
	  <xsd:sequence>
	    <xsd:element name="value" type="subbable_integer" maxOccurs="4" default="3"/>
	  </xsd:sequence>
	</xsd:complexType>
      </xsd:element>	
      <xsd:element name="limit" minOccurs="0" type="subbable_integer" default="25"/>
      <xsd:element name="enforce" minOccurs="0" type="yes_no_Type" default="yes"/>
      <xsd:element name="nval" type="subbable_float" minOccurs="0" default="-999.25"/>
    </xsd:all>
  </xsd:complexType>
</xsd:schema>
