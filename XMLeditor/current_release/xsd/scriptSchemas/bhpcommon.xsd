<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <xsd:complexType name="emptyType"/>
  
  <xsd:complexType name="yes_no_Type">
    <xsd:simpleContent>
      <xsd:restriction base="xsd:string">
        <xsd:enumeration value="yes"/>
        <xsd:enumeration value="no"/>
      </xsd:restriction>
    </xsd:simpleContent>
    <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
  </xsd:complexType>

  <xsd:complexType name="bitBoolType">
    <xsd:simpleContent>
      <xsd:restriction base="xsd:integer">
        <xsd:enumeration value="0"/>
        <xsd:enumeration value="1"/>
      </xsd:restriction>
    </xsd:simpleContent>
    <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
  </xsd:complexType>

  <xsd:complexType name="R_I_Type">
    <xsd:simpleContent>
      <xsd:restriction base="xsd:string">
        <xsd:enumeration value="R"/>
        <xsd:enumeration value="I"/>
      </xsd:restriction>
    </xsd:simpleContent>
    <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
  </xsd:complexType>

  <xsd:complexType name="subbable_integer">
    <xsd:simpleContent>
      <xsd:extension base="xsd:integer">
        <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="subbable_long">
    <xsd:simpleContent>
      <xsd:extension base="xsd:long">
        <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="subbable_float">
    <xsd:simpleContent>
      <xsd:extension base="xsd:float">
        <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="subbable_string">
    <xsd:simpleContent>
      <xsd:extension base="xsd:string">
        <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="subbable_anyURI">
    <xsd:simpleContent>
      <xsd:extension base="xsd:anyURI">
        <xsd:attribute name="substitution_string" type="xsd:string" default=""/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

